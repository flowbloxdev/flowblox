<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.PopUp.Views.ComponentPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:FlowBlox.UICore.PopUp.Resources"
    xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Width="560"
    Height="760"
    ResizeMode="NoResize"
    ShowMinButton="False"
    ShowMaxRestoreButton="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DescriptionMarkdownStyle" TargetType="{x:Type FlowDocument}"
                   BasedOn="{x:Static md:MarkdownStyle.Standard}">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#374151" />
                <Setter Property="PagePadding" Value="0" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="LineHeight" Value="20" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineTextBlock"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    Background="#F8FAFC"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="StepImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True" />
                    <TextBlock x:Name="ImagePlaceholderTextBlock"
                               Text="{x:Static resources:ComponentPopupWindowResources.Image_Placeholder}"
                               Foreground="#6B7280"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <ItemsControl x:Name="StepIndicator"
                          Grid.Row="1"
                          HorizontalAlignment="Center"
                          Margin="0,14,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="9"
                                 Height="9"
                                 Margin="5,0"
                                 Fill="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <md:MarkdownScrollViewer x:Name="DescriptionMarkdown"
                                     Grid.Row="2"
                                     MarkdownStyle="{StaticResource DescriptionMarkdownStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     MaxHeight="260"
                                     IsToolBarVisible="False"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,18,0,0"
                   LastChildFill="False">
            <Button x:Name="NextButton"
                    DockPanel.Dock="Right"
                    MinWidth="120"
                    IsDefault="True"
                    Click="NextButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial x:Name="NextButtonIcon"
                                                Kind="ArrowRight"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Save}" />
                    <TextBlock x:Name="NextButtonTextBlock" />
                </StackPanel>
            </Button>
            <Button x:Name="PreviousButton"
                    DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    MinWidth="120"
                    Click="PreviousButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Back}" />
                    <TextBlock Text="{x:Static resources:ComponentPopupWindowResources.Button_Previous}" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</mah:MetroWindow>
