<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.Views.PSProjectsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:FlowBlox.UICore.ViewModels"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:launcher="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="{x:Static resources:PSProjectsWindow.Title}"
    Height="800"
    Width="1100"
    MinWidth="900"
    MinHeight="600"
    mc:Ignorable="d"
    WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <viewModel:PSProjectsViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ProjectCreatorNameConverter x:Key="ProjectCreatorNameConverter" />

            <Style x:Key="FlowBlox.CopyIconButton"
                   TargetType="{x:Type Button}">

                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="MinWidth" Value="24"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FlowBlox.CopyIcon"
                   TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Opacity" Value="0.65"/>
                <Setter Property="Foreground" Value="DimGray"/>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="1.0"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="0.75"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Value="False">
                        <Setter Property="Opacity" Value="0.35"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>
            <converters:CollectionContainsToVisibilityConverter x:Key="CollectionContainsToVisibilityConverter"/>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Header -->
        <Border Style="{DynamicResource FlowBlox.DialogHeader}"
                DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="FolderSearchOutline"
                                            Width="30"
                                            Height="30"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}"/>
                <TextBlock Style="{DynamicResource FlowBlox.DialogHeaderTitle}" Text="{x:Static resources:PSProjectsWindow.Header_Title_Main}"/>
            </StackPanel>
        </Border>

        <!-- Description -->
        <Border Style="{DynamicResource FlowBlox.DialogDescription}"
                DockPanel.Dock="Top"
                Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource FlowBlox.DialogDescriptionText}" Text="{x:Static resources:PSProjectsWindow.Header_Description_Main}"/>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <ToolBar Grid.Row="0" VerticalAlignment="Center">

                <Button Command="{Binding LoginCommand}"
                        Visibility="{Binding CanLogin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Account" Margin="0,0,5,0" Style="{StaticResource FlowBlox.WindowActionIcon.Execute}"/>
                            <TextBlock Text="{x:Static resources:PSProjectsWindow.Button_Login}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Command="{Binding RegisterCommand}"
                        Visibility="{Binding CanRegister, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountPlus" Margin="0,0,5,0" Style="{StaticResource FlowBlox.WindowActionIcon.Execute}"/>
                            <TextBlock Text="{x:Static resources:ExtensionsWindow.Button_Register}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Command="{Binding LogoutCommand}"
                        Visibility="{Binding CanLogout, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Logout" Margin="0,0,5,0" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                            <TextBlock Text="{x:Static resources:PSProjectsWindow.Button_Logout}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Separator Visibility="{Binding CanToggleMyProjects, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Filter: My/Public -->
                <ToggleButton IsChecked="{Binding IsMine}"
                              Visibility="{Binding CanToggleMyProjects, Converter={StaticResource BoolToVisibilityConverter}}"
                              ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_FilterMine}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AccountBoxOutline" Margin="0,0,5,0"/>
                        <TextBlock Text="{x:Static resources:PSProjectsWindow.Toggle_MyProjects}"/>
                    </StackPanel>
                </ToggleButton>

                <Separator/>

                <!-- User display -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding ActiveUser, Converter={StaticResource NullToVisibilityConverter}}">

                    <iconPacks:PackIconMaterial Kind="Account"
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center"
                                                Foreground="Dimgray"
                                                Margin="0,0,3,0" />

                    <Label FontWeight="SemiBold"
                           Content="{Binding ActiveUser.UserName}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />

                    <!-- Edit user properties -->
                    <Button Command="{Binding EditUserPropertiesCommand}"
                            Padding="2"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0">
                        <iconPacks:PackIconMaterial Kind="PencilOutline"
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"  Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                    </Button>
                </StackPanel>

            </ToolBar>

            <!-- Main -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition Width="*" MinWidth="430"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="260"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchTextBox_KeyDown"/>
                    <Button Margin="6,0,0,0" Command="{Binding SearchCommand}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Magnify" Margin="0,0,5,0" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                <TextBlock Text="{x:Static resources:PSProjectsWindow.Button_Search}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <!-- Project cards + empty state -->
                <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,14,0">
                    <ListBox x:Name="ProjectCards"
                              ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              SelectionMode="Single"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="{x:Static resources:PSProjectsWindow.Header_Title_Main}"
                              MouseDoubleClick="ProjectCards_MouseDoubleClick"
                              KeyDown="ProjectCards_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder" Padding="14"
                                                    Background="#FFF7F9FB" BorderBrush="#FFD5DEE7"
                                                    BorderThickness="1" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#FFF0F5FA"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFA7C0D8"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#FFE8F1FA"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF3A6EA5"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0"
                                                  ToolTip="{x:Static launcher:ProjectLauncher.Favorite}"
                                                  Loaded="FavoriteButton_Loaded" Click="FavoriteButton_Click"
                                                  PreviewMouseDoubleClick="FavoriteButton_PreviewMouseDoubleClick">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <iconPacks:PackIconMaterial x:Name="FavoriteStar" Kind="StarOutline"
                                                                                           Width="20" Height="20" Foreground="#8C969D"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="FavoriteStar" Property="Kind" Value="Star"/>
                                                                    <Setter TargetName="FavoriteStar" Property="Foreground" Value="#F5A23D"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Border Width="42" Height="42" Margin="0,0,12,0"
                                            VerticalAlignment="Top" Background="#143A6EA5" CornerRadius="21">
                                        <iconPacks:PackIconMaterial Kind="FolderOutline" Width="23" Height="23"
                                            Foreground="#3A6EA5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#263238"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/>
                                        <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}"
                                                   Margin="0,4,0,0" Foreground="#546E7A" MaxHeight="54"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Margin="0,9,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                                        Visibility="{Binding CreatedBy, Converter={StaticResource NullToVisibilityConverter}}"
                                                        ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_CreatedBy}">
                                                <iconPacks:PackIconMaterial Kind="AccountOutline" Width="12" Height="12"
                                                    VerticalAlignment="Center" Foreground="#78909C" Margin="0,0,5,0"/>
                                                <TextBlock FontSize="11" Foreground="#78909C">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource ProjectCreatorNameConverter}">
                                                            <Binding Path="CreatedBy" />
                                                            <Binding Path="DataContext.CreatorNames" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        ToolTip="{x:Static resources:PSProjectsWindow.Header_UpdatedAt}">
                                                <iconPacks:PackIconMaterial Kind="ClockOutline" Width="12" Height="12"
                                                    VerticalAlignment="Center" Foreground="#78909C" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}"
                                                           FontSize="11" Foreground="#78909C"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- No results -->
                    <Grid Margin="20"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Reverse}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="Gray"
                                                    VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Static resources:PSProjectsWindow.Text_NoSearchResults}"
                                   FontSize="14"
                                   Foreground="Gray"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>

                <!-- Details -->
                <ScrollViewer Grid.Column="1"
                              Grid.RowSpan="2"
                              Margin="10,0,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <TabControl BorderThickness="0"
                                Background="Transparent"
                                Visibility="{Binding IsProjectSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- Tab: Details -->
                        <TabItem Header="{x:Static resources:PSProjectsWindow.Tab_Details}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="InformationOutline"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="#3A6EA5"/>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <StackPanel Margin="0,10,0,0">
                                <ToolBar Margin="0,0,0,8"
                                         Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Command="{Binding EditProjectCommand}"
                                            IsEnabled="{Binding CanEditProject}"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Button_Edit}"
                                            AutomationProperties.Name="{x:Static resources:PSProjectsWindow.Button_Edit}">
                                        <iconPacks:PackIconMaterial Kind="PencilOutline" Width="16" Height="16" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                    </Button>
                                    <Button x:Name="DeleteProjectButton"
                                            Command="{Binding DeleteProjectCommand}"
                                            IsEnabled="{Binding CanDeleteProject}"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_DeleteProject}"
                                            ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{x:Static resources:PSProjectsWindow.Button_DeleteProject}">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="16" Height="16" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                    </Button>
                                </ToolBar>

                                <!-- Name -->
                                <Label Content="{x:Static resources:PSProjectsWindow.Label_ProjectName}"
                                       FontWeight="DemiBold"
                                       Margin="0,0,0,5"/>

                                <StackPanel Margin="5,0,0,8"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedProject.Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Style="{StaticResource FlowBlox.CopyIconButton}"
                                            Command="{Binding CopyToClipboardCommand}"
                                            CommandParameter="{Binding SelectedProject.Name}"
                                            Margin="6,0,0,0"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_CopyToClipboard}">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Style="{StaticResource FlowBlox.CopyIcon}"/>
                                    </Button>
                                </StackPanel>

                                <Label Content="{x:Static resources:PSProjectsWindow.Label_ProjectDescription}"
                                       FontWeight="DemiBold"
                                       Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding SelectedProject.Description}"
                                           Margin="5,0,0,8"
                                           TextWrapping="Wrap"/>

                                <Label Content="{x:Static resources:PSProjectsWindow.Label_ProjectGuid}"
                                       FontWeight="DemiBold"
                                       Margin="0,5,0,5"/>

                                <!-- GUID -->
                                <StackPanel Margin="5,0,0,8"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedProject.Guid}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>

                                    <Button Style="{StaticResource FlowBlox.CopyIconButton}"
                                            Command="{Binding CopyToClipboardCommand}"
                                            CommandParameter="{Binding SelectedProject.Guid}"
                                            Margin="6,0,0,0"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_CopyToClipboard}">
                                        <iconPacks:PackIconMaterial Kind="ContentCopy"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Style="{StaticResource FlowBlox.CopyIcon}"/>
                                    </Button>
                                </StackPanel>

                                <Label Content="{x:Static resources:PSProjectsWindow.Label_CreatedAt}"
                                       FontWeight="DemiBold"
                                       Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding SelectedProject.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                           Margin="5,0,0,8"/>

                                <Label Content="{x:Static resources:PSProjectsWindow.Label_UpdatedAt}"
                                       FontWeight="DemiBold"
                                       Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding SelectedProject.UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                           Margin="5,0,0,8"/>

                                <Label Content="{x:Static resources:PSProjectsWindow.Label_Visibility}"
                                       FontWeight="DemiBold"
                                       Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding SelectedProject.Visibility, Converter={StaticResource EnumDisplayNameConverter}}"
                                           Margin="5,0,0,8"/>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab: Versions -->
                        <TabItem Header="{x:Static resources:PSProjectsWindow.Tab_ProjectVersions}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="SourceBranch"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="#3A6EA5"/>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Versions toolbar (icon-only + tooltips) -->
                                <ToolBar Grid.Row="0" Margin="0,0,0,8">
                                    <Button Command="{Binding OpenVersionCommand}"
                                            IsEnabled="{Binding CanOpenVersion}"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Button_OpenVersion}"
                                            AutomationProperties.Name="{x:Static resources:PSProjectsWindow.Button_OpenVersion}">
                                        <iconPacks:PackIconMaterial Kind="SourceBranch" Width="16" Height="16" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                    </Button>
                                    <Separator/>

                                    <Button Command="{Binding CreateVersionCommand}"
                                            IsEnabled="{Binding CanManageVersions}"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_CreateStableVersion}">
                                        <iconPacks:PackIconMaterial Kind="SourceBranchPlus" Width="16" Height="16" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                    </Button>

                                    <Button Command="{Binding EditVersionCommand}"
                                            IsEnabled="{Binding CanEditSelectedVersion}"
                                            Margin="6,0,0,0"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_EditVersionMetadata}">
                                        <iconPacks:PackIconMaterial Kind="PencilOutline" Width="16" Height="16" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                    </Button>

                                    <Button Command="{Binding DownloadVersionCommand}"
                                            IsEnabled="{Binding CanDownloadSelectedVersion}"
                                            Margin="6,0,0,0"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_DownloadVersion}">
                                        <iconPacks:PackIconMaterial Kind="DownloadOutline" Width="16" Height="16" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                    </Button>

                                    <Button Command="{Binding RefreshVersionsCommand}"
                                            IsEnabled="{Binding CanManageVersions}"
                                            Margin="10,0,0,0"
                                            ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_RefreshVersions}">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Style="{StaticResource FlowBlox.ToolbarIconBase}"/>
                                    </Button>

                                </ToolBar>

                                <!-- Versions list -->
                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding ProjectVersions}"
                                          SelectedItem="{Binding SelectedVersion}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static resources:PSProjectsWindow.Header_Version}"
                                                            DisplayMemberBinding="{Binding VersionNumber}"
                                                            Width="70"/>
                                            <GridViewColumn Header="{x:Static resources:PSProjectsWindow.Header_CreatedAt}"
                                                            Width="150">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static resources:PSProjectsWindow.Header_Comment}"
                                                            DisplayMemberBinding="{Binding Comment}"
                                                            Width="260"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- Version details below the table -->
                                <Border Grid.Row="2"
                                        Margin="0,10,0,0"
                                        Padding="12"
                                        CornerRadius="4"
                                        Background="#FFFAF3D1"
                                        BorderBrush="#FFE0C869"
                                        BorderThickness="1"
                                        Visibility="{Binding IsVersionSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <StackPanel>

                                        <!-- Heading -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <iconPacks:PackIconMaterial Kind="InformationOutline"
                                                                        Width="16"
                                                                        Height="16"
                                                                        Margin="0,1,8,0"
                                                                        Foreground="#FF6B5A1E"
                                                                        VerticalAlignment="Top"/>
                                            <TextBlock Text="{x:Static resources:PSProjectsWindow.Label_VersionDetailsHeader}"
                                                       FontWeight="DemiBold"
                                                       Foreground="#FF6B5A1E"
                                                       FontSize="14"/>
                                        </StackPanel>

                                        <Label Content="{x:Static resources:PSProjectsWindow.Label_VersionNumber}"
                                               FontWeight="DemiBold"
                                               Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding SelectedVersion.VersionNumber}" Margin="5,0,0,8"/>

                                        <StackPanel Visibility="{Binding SelectedProject.CreatedBy, Converter={StaticResource NullToVisibilityConverter}}"
                                                    ToolTip="{x:Static resources:PSProjectsWindow.Tooltip_CreatedBy}">
                                            <Label Content="{x:Static resources:PSProjectsWindow.Label_CreatedBy}"
                                                   FontWeight="DemiBold" Margin="0,5,0,5"/>
                                            <TextBlock Margin="5,0,0,8">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource ProjectCreatorNameConverter}">
                                                        <Binding Path="SelectedProject.CreatedBy" />
                                                        <Binding Path="CreatorNames" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <Label Content="{x:Static resources:PSProjectsWindow.Label_VersionCreatedAt}"
                                               FontWeight="DemiBold"
                                               Margin="0,5,0,5"/>
                                        <TextBlock Text="{Binding SelectedVersion.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                   Margin="5,0,0,8"/>

                                        <Label Content="{x:Static resources:PSProjectsWindow.Label_VersionComment}"
                                               FontWeight="DemiBold"
                                               Margin="0,5,0,5"/>
                                        <TextBlock Text="{Binding SelectedVersion.Comment}"
                                                   Margin="5,0,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </TabItem>

                    </TabControl>

                </ScrollViewer>
            </Grid>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{x:Static resources:PSProjectsWindow.Button_Back}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"/>
                <Button Style="{StaticResource FlowBlox.WindowActionButton}"
                        Command="{Binding OpenProjectCommand}"
                        IsEnabled="{Binding IsProjectSelected}"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource FlowBlox.WindowActionIcon.Execute}"/>
                        <TextBlock Text="{x:Static resources:PSProjectsWindow.Button_Open}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>
    </DockPanel>
</mah:MetroWindow>
