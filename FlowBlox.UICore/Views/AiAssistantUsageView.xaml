<UserControl x:Class="FlowBlox.UICore.Views.AiAssistantUsageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="UsageCard">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding UsageMetrics}" Margin="0,10,0,0" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" ToolTip="{Binding Label}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UsageValue" />
                                </Grid.ColumnDefinitions>
                                <icons:PackIconMaterial Kind="{Binding Icon}" Width="14" Height="14" Foreground="#FF52708B"
                                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" Foreground="#FF52616E"
                                           Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Right"
                                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <views:AiAssistantDebugSelectionHeader />
        <views:AiAssistantDebugCardList Grid.Row="1" CardTemplate="{StaticResource UsageCard}" />
    </Grid>
</UserControl>
