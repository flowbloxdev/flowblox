<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.Views.ProjectPanelGridSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    Title="{x:Static resources:ProjectPanelGridSettingsWindow.Title}"
    Width="700"
    Height="500"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border Style="{DynamicResource FlowBlox.DialogHeader}" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="CogBox"
                                            Width="28"
                                            Height="28"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}" />
                <TextBlock Style="{DynamicResource FlowBlox.DialogHeaderTitle}" Text="{x:Static resources:ProjectPanelGridSettingsWindow.Header_Title}" />
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource FlowBlox.DialogDescription}"
                DockPanel.Dock="Top"
                Margin="0,0,0,8">
            <TextBlock Style="{DynamicResource FlowBlox.DialogDescriptionText}" Text="{x:Static resources:ProjectPanelGridSettingsWindow.Header_Description}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Vertical">
                <TextBlock Text="{x:Static resources:ProjectPanelGridSettingsWindow.Label_GridWidth}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="GridWidthTextBox"
                         Height="32"
                         Text="{Binding GridWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         PreviewTextInput="NumericTextBox_PreviewTextInput" />

                <TextBlock Text="{x:Static resources:ProjectPanelGridSettingsWindow.Label_GridHeight}"
                           Margin="0,16,0,6" />
                <TextBox x:Name="GridHeightTextBox"
                         Height="32"
                         Text="{Binding GridHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         PreviewTextInput="NumericTextBox_PreviewTextInput" />

                <TextBlock Text="{x:Static resources:ProjectPanelGridSettingsWindow.Label_AutoIncreaseGridSize}"
                           Margin="0,16,0,6" />
                <mah:ToggleSwitch IsOn="{Binding AutoIncreaseGridSize, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  OffContent="{x:Static resources:ProjectPanelGridSettingsWindow.Toggle_Off}"
                                  OnContent="{x:Static resources:ProjectPanelGridSettingsWindow.Toggle_On}">
                    <mah:ToggleSwitch.ToolTip>
                        <ToolTip Content="{x:Static resources:ProjectPanelGridSettingsWindow.Tooltip_AutoIncreaseGridSize}" />
                    </mah:ToggleSwitch.ToolTip>
                </mah:ToggleSwitch>

                <TextBlock Text="{x:Static resources:ProjectPanelGridSettingsWindow.Label_ResetNotifications}"
                           Margin="0,16,0,6" />
                <mah:ToggleSwitch IsOn="{Binding ResetNotificationsOnRuntimeFinish, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  OffContent="{x:Static resources:ProjectPanelGridSettingsWindow.Toggle_Off}"
                                  OnContent="{x:Static resources:ProjectPanelGridSettingsWindow.Toggle_On}">
                    <mah:ToggleSwitch.ToolTip>
                        <ToolTip Content="{x:Static resources:ProjectPanelGridSettingsWindow.Tooltip_ResetNotifications}" />
                    </mah:ToggleSwitch.ToolTip>
                </mah:ToggleSwitch>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{x:Static resources:ProjectPanelGridSettingsWindow.Button_Back}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                        IsCancel="True"
                        Click="BackButton_Click" />

                <Button IsDefault="True"
                        Content="{x:Static resources:ProjectPanelGridSettingsWindow.Button_Save}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Save}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
