<UserControl
    x:Class="FlowBlox.UICore.Views.PropertyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:FlowBlox.UICore.ViewModels.PropertyView"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:behavior="clr-namespace:FlowBlox.UICore.Behavior"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewModel:PropertyViewModel />
    </UserControl.DataContext>
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/PropertyViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- TabControl -->
        <TabControl ItemsSource="{Binding VisibleTabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    Style="{StaticResource FlowBlox.ScrollableHeaderTabControl}"
                    Margin="4,0,4,0"
                    DockPanel.Dock="Top">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.TabText}"/>
                    <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.TabBackground}"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlowBlox.Brush.TabBackground}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.TabHover}"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.TabSelected}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TabTitle}"
                        FontSize="16"
                        Margin="0,0,0,6" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <ScrollViewer Visibility="{Binding HasMaximizedControl, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Controls}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel behavior:ToolTipPreferenceBehavior.PreferChildToolTips="True"
                                                        Margin="0,0,0,10"
                                                        IsEnabled="{Binding IsEnabled}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border
                                                    Style="{StaticResource PropertyView.LabelBorderStyle}"
                                                    Visibility="{Binding UseLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            Text="{Binding Label}"
                                                            Style="{StaticResource PropertyView.LabelTextStyle}" />
                                                        <Border
                                                            Style="{StaticResource PropertyView.HelpIconBorderStyle}"
                                                            Visibility="{Binding HasTooltip, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock
                                                                Text="?"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Foreground="White" />
                                                            <Border.ToolTip>
                                                                <ToolTip
                                                                    Style="{StaticResource PropertyView.HelpToolTipStyle}"
                                                                    Content="{Binding TooltipText}" />
                                                            </Border.ToolTip>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <ContentControl Content="{Binding Control}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ItemsControl ItemsSource="{Binding MaximizedControls}"
                                      Visibility="{Binding HasMaximizedControl, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid behavior:ToolTipPreferenceBehavior.PreferChildToolTips="True"
                                          IsEnabled="{Binding IsEnabled}"
                                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Style="{StaticResource PropertyView.LabelBorderStyle}"
                                                Visibility="{Binding UseLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Text="{Binding Label}"
                                                    Style="{StaticResource PropertyView.LabelTextStyle}" />
                                                <Border
                                                    Style="{StaticResource PropertyView.HelpIconBorderStyle}"
                                                    Visibility="{Binding HasTooltip, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock
                                                        Text="?"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="White" />
                                                    <Border.ToolTip>
                                                        <ToolTip
                                                            Style="{StaticResource PropertyView.HelpToolTipStyle}"
                                                            Content="{Binding TooltipText}" />
                                                    </Border.ToolTip>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <ContentControl Grid.Row="1"
                                                        Content="{Binding Control}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</UserControl>
