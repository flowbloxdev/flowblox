<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    x:Class="FlowBlox.UICore.Views.ManageNotificationsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:FlowBlox.UICore.ViewModels"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="{x:Static resources:ManageNotificationsWindow.Title}"
    Height="560" Width="780" MinHeight="400" MinWidth="620"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner" mc:Ignorable="d">

    <Window.DataContext>
        <viewModel:ManageNotificationOverridesViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="20">

        <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogHeader}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="BellCogOutline" Width="32" Height="32" Margin="0,0,10,0" />
                <TextBlock Text="{x:Static resources:ManageNotificationsWindow.Title}"
                           Style="{DynamicResource FlowBlox.DialogHeaderTitle}" />
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource FlowBlox.DialogDescription}"
            DockPanel.Dock="Top">
            <TextBlock Style="{DynamicResource FlowBlox.DialogDescriptionText}" Text="{x:Static resources:ManageNotificationsWindow.HeaderDescription}" />
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{DynamicResource FlowBlox.DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ResetCommand}"
                        Style="{StaticResource FlowBlox.WindowActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Restore" Width="16" Height="16"
                                                    Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#E57373" />
                        <AccessText Text="{x:Static resources:ManageNotificationsWindow.Button_Reset}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{x:Static resources:ManageNotificationsWindow.Button_Back}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}" />
                <Button Content="{x:Static resources:ManageNotificationsWindow.Button_Save}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Style="{StaticResource FlowBlox.WindowActionButton.Save}" />
            </StackPanel>
        </Border>

        <Grid Margin="0,8,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resources:ManageNotificationsWindow.GridColumn_Message}" Binding="{Binding EnumDisplayName}" IsReadOnly="True" Width="*" />
                    <DataGridComboBoxColumn Header="{x:Static resources:ManageNotificationsWindow.GridColumn_NotificationType}"
                                        SelectedItemBinding="{Binding SelectedNotificationType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*">

                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="ItemsSource"
                                Value="{Binding DataContext.NotificationTypes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>

                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="ItemsSource"
                                Value="{Binding DataContext.NotificationTypes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>

                    </DataGridComboBoxColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </DockPanel>
</mah:MetroWindow>
