<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.Views.FieldSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:propertyconverters="clr-namespace:FlowBlox.UICore.Converters.PropertyView"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    Title="{x:Static resources:FieldSelectionWindow.Title}"
    Height="640"
    Width="980"
    mc:Ignorable="d"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <propertyconverters:FlowBloxComponentIcon16Converter x:Key="FieldIconConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Header -->
        <Border Style="{DynamicResource FlowBlox.DialogHeader}" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="FormatListBulleted"
                                            Width="28"
                                            Height="28"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}"/>
                <TextBlock Style="{DynamicResource FlowBlox.DialogHeaderTitle}" Text="{x:Static resources:FieldSelectionWindow.Header_Title}" />
            </StackPanel>
        </Border>

        <!-- Description -->
        <Border Style="{DynamicResource FlowBlox.DialogDescription}"
                DockPanel.Dock="Top"
                Margin="0,0,0,8">
            <TextBlock Style="{DynamicResource FlowBlox.DialogDescriptionText}" Text="{x:Static resources:FieldSelectionWindow.Header_Description}" />
        </Border>

        <!-- Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Keep the lists bounded so their own ScrollViewers handle wheel input and virtualization. -->
            <Border Grid.Row="0">

                <Grid>
                    <TabControl SelectedIndex="{Binding SelectedTabIndex}">

                        <!-- Project Fields -->
                        <TabItem Header="{x:Static resources:FieldSelectionWindow.Tab_ProjectFields}"
                                 Visibility="{Binding CanSelectFields, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="DatabaseOutline"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="#3A6EA5"/>
                                        <TextBlock Text="{Binding}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <Grid>
                                <ListView x:Name="FieldsListView"
                                          ItemsSource="{Binding FieldRows}"
                                          MouseDoubleClick="FieldsListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="32">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image
                                                            Source="{Binding FieldElement, Converter={StaticResource FieldIconConverter}}"
                                                            Width="16"
                                                            Height="16"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="28">
                                                <GridViewColumn.Header>
                                                    <iconPacks:PackIconMaterial Kind="LinkVariant"
                                                                                Width="14" Height="14"
                                                                                Foreground="#356F9F"
                                                                                ToolTip="{x:Static resources:FieldSelectionWindow.Col_Connected}"
                                                                                AutomationProperties.Name="{x:Static resources:FieldSelectionWindow.Col_Connected}"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <iconPacks:PackIconMaterial Width="16" Height="16"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center">
                                                            <iconPacks:PackIconMaterial.Style>
                                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                                    <Setter Property="Kind" Value="LinkVariantOff"/>
                                                                    <Setter Property="Foreground" Value="#C0C7CE"/>
                                                                    <Setter Property="ToolTip" Value="{x:Static resources:FieldSelectionWindow.Required_Off}"/>
                                                                    <Setter Property="AutomationProperties.Name" Value="{x:Static resources:FieldSelectionWindow.Required_Off}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Kind" Value="LinkVariant"/>
                                                                            <Setter Property="Foreground" Value="#356F9F"/>
                                                                            <Setter Property="ToolTip" Value="{x:Static resources:FieldSelectionWindow.Required_On}"/>
                                                                            <Setter Property="AutomationProperties.Name" Value="{x:Static resources:FieldSelectionWindow.Required_On}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsUserField}" Value="True">
                                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </iconPacks:PackIconMaterial.Style>
                                                        </iconPacks:PackIconMaterial>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_Source}"
                                                            DisplayMemberBinding="{Binding SourceName}"
                                                            Width="260"/>

                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_Field}"
                                                            DisplayMemberBinding="{Binding FieldName}"
                                                            Width="440"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>

                        <!-- Project Properties -->
                        <TabItem Header="{x:Static resources:FieldSelectionWindow.Tab_ProjectProperties}"
                                 Visibility="{Binding CanSelectProjectProperties, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="FolderTextOutline"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="#6A1B9A"/>
                                        <TextBlock Text="{Binding}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <Grid>
                                <ListView x:Name="ProjectPropertiesListView"
                                          ItemsSource="{Binding ProjectPropertyRows}"
                                          MouseDoubleClick="ProjectPropertiesListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyName}"
                                    DisplayMemberBinding="{Binding Name}"
                                    Width="260"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyKey}"
                                    DisplayMemberBinding="{Binding Key}"
                                    Width="220"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_OptionDescription}"
                                    DisplayMemberBinding="{Binding Description}"
                                    Width="320"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyValue}"
                                    DisplayMemberBinding="{Binding Value}"
                                    Width="160"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>

                        <!-- Options -->
                        <TabItem Header="{x:Static resources:FieldSelectionWindow.Tab_Options}"
                                 Visibility="{Binding CanSelectOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="TuneVariant"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <Grid>
                                <ListView x:Name="OptionsListView"
                                          ItemsSource="{Binding OptionRows}"
                                          MouseDoubleClick="OptionsListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_OptionName}"
                                                            DisplayMemberBinding="{Binding Name}"
                                                            Width="260"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_OptionType}"
                                                            DisplayMemberBinding="{Binding Type}"
                                                            Width="180"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_OptionDescription}"
                                                            DisplayMemberBinding="{Binding Description}"
                                                            Width="360"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_OptionValue}"
                                                            DisplayMemberBinding="{Binding Value}"
                                                            Width="160"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>

                        <!-- Input files -->
                        <TabItem Header="{x:Static resources:FieldSelectionWindow.Tab_InputFiles}"
                                 Visibility="{Binding CanSelectInputFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="#1565C0"/>
                                        <TextBlock Text="{Binding}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <Grid>
                                <ListView x:Name="InputFilesListView"
                                          ItemsSource="{Binding InputFileRows}"
                                          MouseDoubleClick="InputFilesListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyName}"
                                                            DisplayMemberBinding="{Binding Name}"
                                                            Width="260"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyKey}"
                                                            DisplayMemberBinding="{Binding Key}"
                                                            Width="220"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyDescription}"
                                                            DisplayMemberBinding="{Binding Description}"
                                                            Width="320"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>

                        <!-- Generation strategy data -->
                        <TabItem Header="{x:Static resources:FieldSelectionWindow.Tab_GenerationStrategyData}"
                                 Visibility="{Binding CanSelectGenerationStrategyData, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="Brain"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="#EF6C00"/>
                                        <TextBlock Text="{Binding}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <Grid>
                                <ListView x:Name="GenerationStrategyDataListView"
                                          ItemsSource="{Binding GenerationStrategyDataRows}"
                                          MouseDoubleClick="GenerationStrategyDataListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyName}"
                                                            DisplayMemberBinding="{Binding Name}"
                                                            Width="260"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyKey}"
                                                            DisplayMemberBinding="{Binding Key}"
                                                            Width="220"/>
                                            <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyDescription}"
                                                            DisplayMemberBinding="{Binding Description}"
                                                            Width="320"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Vault" Visibility="{Binding CanSelectVault, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="SafeSquareOutline" Foreground="#22B8CF" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" Padding="0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>
                            <ListView x:Name="VaultListView" ItemsSource="{Binding VaultRows}" MouseDoubleClick="FieldsListView_MouseDoubleClick">
                                <ListView.View><GridView>
                                    <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyName}" DisplayMemberBinding="{Binding Name}" Width="220"/>
                                    <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_VaultReference}" DisplayMemberBinding="{Binding Reference}" Width="290"/>
                                    <GridViewColumn Header="{x:Static resources:FieldSelectionWindow.Col_ProjectPropertyDescription}" DisplayMemberBinding="{Binding Description}" Width="340"/>
                                </GridView></ListView.View>
                            </ListView>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- Required (Fields only) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource FlowBlox.Brush.InformationBackground}"
                    Padding="10"
                    CornerRadius="4"
                    Margin="0,8,0,0"
                    Visibility="{Binding ShowRequired, Converter={StaticResource BoolToVisibilityConverter}}">

                <StackPanel>
                    <mah:ToggleSwitch IsOn="{Binding IsRequired}"
                                      Header="{x:Static resources:FieldSelectionWindow.Required_ToggleHeader}"
                                      OnContent="{x:Static resources:FieldSelectionWindow.Required_On}"
                                      OffContent="{x:Static resources:FieldSelectionWindow.Required_Off}">
                        <mah:ToggleSwitch.ToolTip>
                            <ToolTip Content="{x:Static resources:FieldSelectionWindow.Required_HintShort}" />
                        </mah:ToggleSwitch.ToolTip>
                    </mah:ToggleSwitch>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <iconPacks:PackIconMaterial Kind="InformationOutline"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    Foreground="#3A6EA5"
                                                    VerticalAlignment="Top" />
                        <TextBlock Text="{x:Static resources:FieldSelectionWindow.Required_InfoText}"
                                   Foreground="DarkSlateGray"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{x:Static resources:FieldSelectionWindow.Button_Back}"
                        Command="{Binding BackCommand}"
                        IsCancel="True"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}" />

                <Button x:Name="OkButton" 
                        Command="{Binding OkCommand}" 
                        IsEnabled="False"
                        Style="{StaticResource FlowBlox.WindowActionButton}"
                        IsDefault="True">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Check"
                                                        Style="{StaticResource FlowBlox.WindowActionIcon.Apply}"/>
                            <TextBlock Text="{x:Static resources:FieldSelectionWindow.Button_Ok}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
