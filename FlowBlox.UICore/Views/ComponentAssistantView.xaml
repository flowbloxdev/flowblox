<UserControl x:Class="FlowBlox.UICore.Views.ComponentAssistantView"
             x:Name="ComponentAssistantRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Visibility="Collapsed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <Thumb x:Name="ResizeHandle" Width="5" Grid.Column="0" Cursor="SizeWE"
               Visibility="Collapsed" DragDelta="ResizeHandle_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource FlowBlox.Brush.Border}" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <ContentControl x:Name="AssistantHost" Grid.Column="1" Width="400" Visibility="Collapsed"
                        Background="{DynamicResource FlowBlox.Brush.ToolbarBackground}" />
        <Border Grid.Column="2" Background="{DynamicResource FlowBlox.Brush.ToolbarBackground}"
                BorderBrush="{DynamicResource FlowBlox.Brush.Border}" BorderThickness="1,0,0,0">
            <ToggleButton x:Name="AssistantToggle" Width="28" Margin="1,0"
                          FocusVisualStyle="{x:Null}"
                          VerticalAlignment="Stretch" ToolTip="{Binding ToggleTooltip, ElementName=ComponentAssistantRoot}"
                          AutomationProperties.Name="{Binding ToggleTooltip, ElementName=ComponentAssistantRoot}"
                          Checked="AssistantToggle_Changed" Unchecked="AssistantToggle_Changed">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="Transparent">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="RobotOutline" Width="20" Height="20" Foreground="#4F60C6"
                                                            HorizontalAlignment="Center" />
                                <Border x:Name="ChevronBackground" Width="24" Height="24" Margin="0,8,0,0"
                                        CornerRadius="5" Background="#D8E7FA">
                                    <iconPacks:PackIconMaterial x:Name="Chevron" Kind="ChevronRight" Width="17" Height="17"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1769B0" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#14537CC4" />
                                <Setter TargetName="ChevronBackground" Property="Background" Value="#BED5F5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChevronBackground" Property="Background" Value="#C6DAF7" />
                                <Setter TargetName="Chevron" Property="Kind" Value="ChevronLeft" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Border>
    </Grid>
</UserControl>
