<mah:MetroWindow x:Class="FlowBlox.UICore.Views.VaultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    Style="{DynamicResource FlowBlox.Window}"
    Title="{x:Static resources:VaultWindow.Title}" Width="920" Height="620"
    MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml"/>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Vault.CardItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Padding="12" CornerRadius="6" Background="#FFF7F9FB"
                                    BorderBrush="#FFD8E0E8" BorderThickness="1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#FFE8F1FC"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF2F6DB3"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF2F6DB3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogHeader}">
            <StackPanel Orientation="Horizontal">
                <icons:PackIconMaterial Kind="SafeSquareOutline" Foreground="#22B8CF" Width="28" Height="28" Margin="0,0,10,0"/>
                <TextBlock Text="{x:Static resources:VaultWindow.Title}" Style="{DynamicResource FlowBlox.DialogHeaderTitle}"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogDescription}">
            <TextBlock Text="{x:Static resources:VaultWindow.Description}" Style="{DynamicResource FlowBlox.DialogDescriptionText}"/>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource FlowBlox.WindowActionButton.Back}" Click="Back_Click" IsCancel="True"
                    Content="{x:Static resources:VaultWindow.Button_Back}" />
            <Button Content="{x:Static resources:VaultWindow.Apply}" Style="{StaticResource FlowBlox.WindowActionButton.Apply}"
                    IsEnabled="{Binding IsDirty}" Click="Apply_Click"/>
        </StackPanel>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Click="Add_Click" Style="{StaticResource FlowBlox.WindowActionButton}">
                        <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Plus" Foreground="#2E8B57" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{x:Static resources:VaultWindow.Add}"/></StackPanel>
                    </Button>
                    <Button Content="{x:Static resources:VaultWindow.Delete}" Click="Delete_Click" IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource FlowBlox.WindowActionButton.Delete}"/>
                </StackPanel>
                <ListBox x:Name="EntriesList" ItemsSource="{Binding Entries}" SelectionChanged="Entries_SelectionChanged"
                         ItemContainerStyle="{StaticResource Vault.CardItem}" BorderThickness="0" Background="Transparent"
                         Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         IsSynchronizedWithCurrentItem="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#263238" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Reference}" FontSize="11" Foreground="#547282" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Preview}" Foreground="#607D8B" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Grid Grid.Column="2">
                <TextBlock x:Name="NoSelectionHint" Text="{Binding NoSelectionText}" TextWrapping="Wrap"
                           Foreground="#607D8B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel x:Name="EntryEditor">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{x:Static resources:VaultWindow.Name}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SelectedEntry.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{x:Static resources:VaultWindow.NameHint}" TextWrapping="Wrap" Foreground="#78909C" FontSize="11" Margin="0,4,0,12"/>
                    <TextBlock Text="{x:Static resources:VaultWindow.Label}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SelectedEntry.Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <TextBlock Text="{x:Static resources:VaultWindow.Value}" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ValueEditor" Text="{Binding SelectedEntry.Value, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" MinHeight="30"/>
                        <PasswordBox x:Name="PasswordEditor" PasswordChanged="Password_Changed" MinHeight="30"/>
                        <ToggleButton x:Name="MaskValueButton" Grid.Column="1" IsChecked="{Binding SelectedEntry.IsPassword}"
                                      Width="32" Height="30" Margin="6,0,0,0" VerticalAlignment="Top"
                                      AutomationProperties.Name="{x:Static resources:VaultWindow.Password}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="#246BA8"/>
                                    <Setter Property="ToolTip" Value="{x:Static resources:VaultWindow.Password}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="#A9C1D4"/>
                                            <Setter Property="ToolTip" Value="{x:Static resources:VaultWindow.ShowValue}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#17558C"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Foreground" Value="#739BB9"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <icons:PackIconMaterial Kind="EyeOutline" Width="20" Height="20"/>
                        </ToggleButton>
                    </Grid>
                    <TextBlock Text="{x:Static resources:VaultWindow.ProtectionHint}" Foreground="#607D8B" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
