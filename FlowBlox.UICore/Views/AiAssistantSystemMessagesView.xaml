<UserControl x:Class="FlowBlox.UICore.Views.AiAssistantSystemMessagesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views"
    xmlns:models="clr-namespace:FlowBlox.AIAssistant.Models;assembly=FlowBlox.AIAssistant"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ContextMenuStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="FilterButtonContent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    <icons:PackIconMaterial Kind="ChevronDown" Width="12" Height="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="FilterMenuItem" TargetType="MenuItem" BasedOn="{StaticResource FlowBlox.ContextMenuItem}">
                <Setter Property="Header" Value="{Binding Label}" />
                <Setter Property="IsCheckable" Value="True" />
                <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="StaysOpenOnClick" Value="True" />
            </Style>
            <Style x:Key="KindBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="Background" Value="#FFE8EDF2" />
                <Setter Property="TextElement.Foreground" Value="#FF435361" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SystemMessageKind}" Value="{x:Static models:AssistantSystemMessageKind.SessionBootstrap}">
                        <Setter Property="Background" Value="#FFE1EDFD" />
                        <Setter Property="TextElement.Foreground" Value="#FF245A92" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SystemMessageKind}" Value="{x:Static models:AssistantSystemMessageKind.Explanation}">
                        <Setter Property="Background" Value="#FFEDE4F8" />
                        <Setter Property="TextElement.Foreground" Value="#FF704397" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SystemMessageKind}" Value="{x:Static models:AssistantSystemMessageKind.TypeInfo}">
                        <Setter Property="Background" Value="#FFFFEFCF" />
                        <Setter Property="TextElement.Foreground" Value="#FF805B14" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SystemMessageKind}" Value="{x:Static models:AssistantSystemMessageKind.ToolDefinition}">
                        <Setter Property="Background" Value="#FFDDF2EF" />
                        <Setter Property="TextElement.Foreground" Value="#FF1E6A62" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OriginBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="Background" Value="#FFEBEEF2" />
                <Setter Property="TextElement.Foreground" Value="#FF52616E" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="Background" Value="#FFE3F1E7" />
                        <Setter Property="TextElement.Foreground" Value="#FF28663F" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="SystemMessageCard">
                <StackPanel>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Border Style="{StaticResource KindBadge}" Margin="0,0,4,4">
                            <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource OriginBadge}" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Origin}" FontSize="10" ToolTip="{Binding OriginTooltip}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding TokensText}" FontSize="11" Foreground="#FF65737E" Margin="0,8,0,0" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="8" Margin="0,0,0,10" CornerRadius="6" BorderBrush="#FFD8E0E8" BorderThickness="1" Background="#FFF7F9FB">
            <StackPanel>
                <WrapPanel>
                    <Button Content="{Binding SystemMessageFilters.KindSummary}" Click="OpenFilterMenu" Margin="0,0,6,6"
                            ContentTemplate="{StaticResource FilterButtonContent}"
                            Style="{DynamicResource FlowBlox.WindowActionButton}" MinWidth="0" Padding="8,4" Height="30"
                            mah:ControlsHelper.CornerRadius="5" ToolTip="{x:Static resources:AiAssistantDebugView.FilterKinds}">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         ItemsSource="{Binding SystemMessageFilters.Kinds}" Placement="Bottom"
                                         ItemContainerStyle="{StaticResource FilterMenuItem}" Style="{StaticResource FlowBlox.ContextMenu}" />
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="{Binding SystemMessageFilters.OriginSummary}" Click="OpenFilterMenu" Margin="0,0,0,6"
                            ContentTemplate="{StaticResource FilterButtonContent}"
                            Style="{DynamicResource FlowBlox.WindowActionButton}" MinWidth="0" Padding="8,4" Height="30"
                            mah:ControlsHelper.CornerRadius="5" ToolTip="{x:Static resources:AiAssistantDebugView.FilterOrigins}">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         ItemsSource="{Binding SystemMessageFilters.Origins}" Placement="Bottom"
                                         ItemContainerStyle="{StaticResource FilterMenuItem}" Style="{StaticResource FlowBlox.ContextMenu}" />
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="{x:Static resources:AiAssistantDebugView.SelectAllFilters}" Command="{Binding SystemMessageFilters.SelectAllCommand}"
                            Style="{DynamicResource FlowBlox.WindowActionButton}" MinWidth="0" Height="28" Padding="8,3" Margin="0,0,6,0"
                            mah:ControlsHelper.CornerRadius="5" />
                    <Button Content="{x:Static resources:AiAssistantDebugView.ClearFilters}" Command="{Binding SystemMessageFilters.ClearCommand}"
                            Style="{DynamicResource FlowBlox.WindowActionButton}" MinWidth="0" Height="28" Padding="8,3" Margin="0"
                            mah:ControlsHelper.CornerRadius="5" />
                </WrapPanel>
                <TextBlock Text="{x:Static resources:AiAssistantDebugView.FilterHint}" FontSize="11" Foreground="#FF65737E"
                           TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>
        </Border>
        <views:AiAssistantDebugSelectionHeader Grid.Row="1" />
        <views:AiAssistantDebugCardList Grid.Row="2" CardTemplate="{StaticResource SystemMessageCard}" />
    </Grid>
</UserControl>
