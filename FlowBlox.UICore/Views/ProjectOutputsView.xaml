<UserControl x:Class="FlowBlox.UICore.Views.ProjectOutputsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/PropertyViewStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ListBox x:Name="OutputNames" SelectionChanged="OutputNames_SelectionChanged" Margin="0,0,12,0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{x:Static resources:ProjectLauncher.OutputGroups}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4,6" ToolTip="{Binding}">
            <icons:PackIconMaterial DockPanel.Dock="Left" Kind="Export" Width="16" Height="16" Foreground="#9270CC" Margin="0,0,8,0" />
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Column="1">
      <ContentControl x:Name="EmptyHint" Content="{x:Static resources:ProjectLauncher.NoResults}"
                      Style="{StaticResource FlowBlox.EmptyState}" Margin="4,12" />
      <ScrollViewer x:Name="SingleResult" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel x:Name="ResultFields" />
      </ScrollViewer>
      <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                CanUserDeleteRows="False" Visibility="Collapsed" EnableRowVirtualization="True"
                EnableColumnVirtualization="True" SelectionUnit="Cell" RowHeight="36" ClipboardCopyMode="IncludeHeader" />
    </Grid>
  </Grid>
</UserControl>
