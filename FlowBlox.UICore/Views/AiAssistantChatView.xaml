<UserControl x:Class="FlowBlox.UICore.Views.AiAssistantChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:aiModels="clr-namespace:FlowBlox.AIAssistant.Models;assembly=FlowBlox.AIAssistant"
             xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/HostedControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="AIAssistantTokenResetButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Opacity="0.72" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AIAssistantTranscriptItemContainerStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AIAssistantTranscriptBubbleStyle" TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Background" Value="#FFF3F4F6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MaxWidth" Value="560" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.User}">
                        <Setter Property="Background" Value="#FFE8F3FF" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.Status}">
                        <Setter Property="Background" Value="#FFFFF7DB" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.Error}">
                        <Setter Property="Background" Value="#FFFDECEC" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolProcessing}">
                        <Setter Property="Background" Value="#FFE8F3FF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolSuccess}">
                        <Setter Property="Background" Value="#FFEAF8EE" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolPartialSuccess}">
                        <Setter Property="Background" Value="#FFE7F6EA" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolError}">
                        <Setter Property="Background" Value="#FFFFF7DB" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AIAssistantTranscriptIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Kind" Value="MessageTextOutline" />
                <Setter Property="Foreground" Value="#FF4B5563" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.User}">
                        <Setter Property="Kind" Value="AccountCircleOutline" />
                        <Setter Property="Foreground" Value="#FF1565C0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.Assistant}">
                        <Setter Property="Kind" Value="RobotOutline" />
                        <Setter Property="Foreground" Value="#FF374151" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.Status}">
                        <Setter Property="Kind" Value="InformationOutline" />
                        <Setter Property="Foreground" Value="#FF8A6D1F" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.Error}">
                        <Setter Property="Kind" Value="AlertCircleOutline" />
                        <Setter Property="Foreground" Value="#FFB71C1C" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolProcessing}">
                        <Setter Property="Kind" Value="ProgressClock" />
                        <Setter Property="Foreground" Value="#FF1565C0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolSuccess}">
                        <Setter Property="Kind" Value="CheckCircle" />
                        <Setter Property="Foreground" Value="#FF2E7D32" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolPartialSuccess}">
                        <Setter Property="Kind" Value="CheckCircleOutline" />
                        <Setter Property="Foreground" Value="#FF2E7D32" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static aiModels:AssistantTranscriptKind.ToolError}">
                        <Setter Property="Kind" Value="AlertBoxOutline" />
                        <Setter Property="Foreground" Value="#FF8A6D1F" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#EDF3F9"
                Padding="10"
                CornerRadius="4"
                Margin="0,0,0,6"
                Visibility="{Binding ShowIntroHeader, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static resources:AiAssistantChatView.Header_Description}"
                       Foreground="DarkSlateGray"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="1"
                Background="#FFF6E27A"
                Padding="10"
                CornerRadius="4"
                Margin="0,0,0,8"
                Visibility="{Binding ShowProviderConfigurationWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static resources:AiAssistantChatView.Warning_MissingProvider}"
                       Foreground="#FF5E4A00"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Background="#FFE8F3FF"
                BorderBrush="#FFB7D6F3"
                BorderThickness="1"
                Padding="8,5"
                CornerRadius="8"
                Margin="0,0,0,8"
                Visibility="{Binding HasEstimatedUsedTokens, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Width="24"
                        Height="24"
                        Margin="8,0,0,0"
                        Style="{StaticResource AIAssistantTokenResetButtonStyle}"
                        Command="{Binding ResetTokenUsageCommand}"
                        ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_ResetTokenUsage}">
                    <iconPacks:PackIconMaterial Kind="CloseCircleOutline"
                                                Width="14"
                                                Height="14"
                                                Foreground="#FF3A6EA5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                </Button>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ChartDonut"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                Foreground="#FF2F6FA8" />
                    <TextBlock Text="{Binding EstimatedUsedTokensText}"
                               Foreground="#FF244B66"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#FFFFFFFF"
                BorderBrush="#FFD0D0D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="TranscriptListBox"
                         Grid.Row="0"
                         ItemsSource="{Binding Transcript}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource AIAssistantTranscriptItemContainerStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AIAssistantTranscriptBubbleStyle}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static resources:AiAssistantChatView.ContextMenu_Copy}"
                                                  Command="{Binding PlacementTarget.Tag.CopyTranscriptEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static resources:AiAssistantChatView.ContextMenu_OpenInEditor}"
                                                  Command="{Binding PlacementTarget.Tag.OpenTranscriptEntryInEditorCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="OpenInNew" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                                Width="16"
                                                                Height="16"
                                                                Margin="0,1,8,0"
                                                                VerticalAlignment="Top"
                                                                Style="{StaticResource AIAssistantTranscriptIconStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               Foreground="#FF1F2937" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsHitTestVisible="False"
                            Grid.Row="0"
                            Opacity="0.16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TranscriptListBox, Path=HasItems}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <iconPacks:PackIconMaterial Kind="RobotOutline"
                                                Width="84"
                                                Height="84"
                                                Foreground="#FF666666"
                                                HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static resources:AiAssistantChatView.Watermark_Title}"
                               Foreground="#FF666666"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="2,4,2,0"
                        Padding="8,6"
                        CornerRadius="8"
                        Background="#FFF4EEFF"
                        BorderBrush="#FFD9C7FF"
                        BorderThickness="1"
                        Visibility="{Binding HasCommunicationStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <mah:ProgressRing IsActive="{Binding HasCommunicationStatus}"
                                          Width="16"
                                          Height="16"
                                          MinWidth="16"
                                          MinHeight="16"
                                          Margin="0,0,8,0"
                                          Foreground="#FF7C3AED" />
                        <TextBlock Text="{Binding CommunicationStatusText}"
                                   VerticalAlignment="Center"
                                   Foreground="#FF4C1D95" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,8,0,8"
                Background="#FFFFFFFF"
                BorderBrush="#FFD0D0D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <Grid>
                <TextBox x:Name="PromptTextBox"
                         Height="180"
                         MinHeight="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         mah:TextBoxHelper.Watermark="{Binding InputWatermark}"
                         mah:TextBoxHelper.WatermarkWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent"
                         IsEnabled="{Binding CanEditInput}"
                         Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="2,0,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="2,0,10,0"
                       VerticalAlignment="Center"
                       Foreground="#FF7A8490"
                       FontSize="10"
                       FontStyle="Italic"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Static resources:AiAssistantChatView.Hint_LineBreakShortcut}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource FlowBlox.RoundedActionButtonStyle}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Width" Value="30" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                    </Style>
                </StackPanel.Resources>
                <Button Margin="0,0,6,0"
                        Command="{Binding SubmitCommand}"
                        ToolTip="{x:Static resources:AiAssistantChatView.Button_Submit}"
                        AutomationProperties.Name="{x:Static resources:AiAssistantChatView.Button_Submit}">
                    <iconPacks:PackIconMaterial Kind="Send"
                                                Width="16"
                                                Height="16"
                                                Style="{StaticResource FlowBlox.ToolbarIconBase}" />
                </Button>
                <Button Margin="0,0,6,0"
                        Command="{Binding DemoPromptsCommand}"
                        ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_DemoPrompts}"
                        AutomationProperties.Name="{x:Static resources:AiAssistantChatView.Button_DemoPrompts}">
                    <iconPacks:PackIconMaterial Kind="PresentationPlay"
                                                Width="16"
                                                Height="16"
                                                Style="{StaticResource FlowBlox.ToolbarIconBase}" />
                </Button>
                <Button Margin="0,0,6,0"
                        Command="{Binding ContinueCommand}"
                        ToolTip="{Binding ContinueTooltip}"
                        AutomationProperties.Name="{Binding ContinueButtonText}">
                    <iconPacks:PackIconMaterial Kind="Play" Width="16" Height="16"
                                                Style="{StaticResource FlowBlox.ToolbarIconBase}" />
                </Button>
                <Button Margin="0,0,6,0"
                        ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_Pause}"
                        AutomationProperties.Name="{Binding PauseButtonText}"
                        Command="{Binding PauseCommand}">
                    <iconPacks:PackIconMaterial Kind="Pause" Width="16" Height="16"
                                                Style="{StaticResource FlowBlox.ToolbarIconBase}" />
                </Button>
                <Button ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_Stop}"
                        AutomationProperties.Name="{x:Static resources:AiAssistantChatView.Button_Stop}"
                        Command="{Binding StopCommand}">
                    <iconPacks:PackIconMaterial Kind="Stop" Width="16" Height="16"
                                                Style="{StaticResource FlowBlox.ToolbarIconBase}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
