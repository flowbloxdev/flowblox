<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    x:Class="FlowBlox.UICore.Views.PropertyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views"
    xmlns:viewModel="clr-namespace:FlowBlox.UICore.ViewModels.PropertyView"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:utilities="clr-namespace:FlowBlox.UICore.Utilities"
    mc:Ignorable="d"
    Title="{Binding HeaderTitle}"
    Height="600"
    Width="800">

    <Window.DataContext>
        <viewModel:PropertyWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border Style="{DynamicResource FlowBlox.DialogHeader}" DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="{Binding HeaderIcon}"
                       Width="32"
                       Height="32"
                       Margin="0,0,10,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding HeaderTitle}"
                           Style="{DynamicResource FlowBlox.DialogHeaderTitle}" />
                <Button Grid.Column="2"
                        Width="20"
                        Height="28"
                        Padding="2"
                        VerticalAlignment="Center"
                        ToolTip="{x:Static resources:PropertyWindow.TransactionMonitor}"
                        Style="{StaticResource FlowBlox.ToolbarButton}"
                        Click="TransactionMenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static resources:PropertyWindow.TransactionMonitor}"
                                      Click="TransactionMonitorButton_Click">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="16" Height="16" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                Width="12"
                                                Height="12"
                                                Style="{StaticResource FlowBlox.ToolbarIconBase}"
                                                Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}" />
                </Button>
            </Grid>
        </Border>

        <!-- Description -->
        <Border Style="{DynamicResource FlowBlox.DialogDescription}"
                DockPanel.Dock="Top"
                Visibility="{Binding HeaderDescription, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding HeaderDescription}"
                       Style="{DynamicResource FlowBlox.DialogDescriptionText}" />
        </Border>

        <!-- Special explanations -->
        <Expander DockPanel.Dock="Top"
                  BorderBrush="{DynamicResource FlowBlox.Brush.Border}"
                  mah:HeaderedControlHelper.HeaderBackground="{DynamicResource FlowBlox.Brush.InformationHeader}"
                  mah:HeaderedControlHelper.HeaderForeground="{DynamicResource FlowBlox.Brush.InformationHeaderText}"
                  Header="{x:Static resources:PropertyWindow.AdditionalInformation}"
                  IsExpanded="False"
                  Visibility="{Binding SpecialExplanations.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <ScrollViewer MaxHeight="250"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border Background="{DynamicResource FlowBlox.Brush.InformationBackground}" Padding="10" BorderBrush="{DynamicResource FlowBlox.Brush.Border}" BorderThickness="1" CornerRadius="4">
                    <ItemsControl ItemsSource="{Binding SpecialExplanations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <iconPacks:PackIconMaterial Kind="{Binding IconKind}"
                                                                Width="16"
                                                                Height="16"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Top"
                                                                Foreground="{Binding IconForeground}"/>
                                    <TextBlock utilities:TextBlockLinkHelper.FormattedText="{Binding DisplayText, Mode=OneWay}"
                                               utilities:TextBlockLinkHelper.AppendLinkText="{x:Static resources:PropertyWindow.ReadMore}"
                                               utilities:TextBlockLinkHelper.AppendLinkCommand="{Binding OpenExplanationCommand}"
                                               TextWrapping="Wrap"
                                               Foreground="DarkSlateGray"
                                               Visibility="{Binding HasContinuationMarker, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock utilities:TextBlockLinkHelper.FormattedText="{Binding DisplayText, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Foreground="DarkSlateGray"
                                               Visibility="{Binding HasContinuationMarker, Converter={StaticResource BoolToInverseVisibilityConverter}}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>
        </Expander>

        <!-- Operations -->
        <Border Background="{DynamicResource FlowBlox.Brush.ToolbarBackground}"
            DockPanel.Dock="Top"
            BorderBrush="#CCC"
            BorderThickness="0,1,0,1"
            Padding="6,4,6,4"
            Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding UIActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}"
                                IsEnabled="{Binding IsEnabled}"
                                ToolTip="{Binding ToolTip}"
                                Margin="3,0"
                                Padding="6,3"
                                MinWidth="80"
                                Style="{StaticResource FlowBlox.ToolbarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0">
                                    </Image>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Command="{Binding RefreshUIActionsCommand}"
                        Visibility="{Binding UIActions.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        ToolTip="{x:Static resources:PropertyWindow.RefreshActions}"
                        Margin="3,0"
                        Padding="6,3"
                        MinWidth="28"
                        Style="{StaticResource FlowBlox.ToolbarButton}">
                    <iconPacks:PackIconMaterial Kind="Refresh"
                                                Width="16"
                                                Height="16"
                                                Style="{StaticResource FlowBlox.ToolbarIconBase}"
                                                Foreground="#3A6EA5"/>
                </Button>
            </StackPanel>
        </Border>

        <views:PropertyWindowFooter DockPanel.Dock="Bottom" />

        <!-- PropertyView Embedding -->
        <views:PropertyView DataContext="{Binding PropertyViewModel}" />

    </DockPanel>
</mah:MetroWindow>
