<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.Views.EditProjectVersionMetadataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="{x:Static resources:EditProjectVersionMetadataWindow.Title}"
    Width="720"
    Height="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Header -->
        <Border Style="{DynamicResource FlowBlox.DialogHeader}"
                DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="PencilOutline"
                                            Width="30"
                                            Height="30"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}"/>
                <TextBlock Style="{DynamicResource FlowBlox.DialogHeaderTitle}" Text="{x:Static resources:EditProjectVersionMetadataWindow.Header_Title}" />
            </StackPanel>
        </Border>

        <!-- Description -->
        <Border Style="{DynamicResource FlowBlox.DialogDescription}"
                DockPanel.Dock="Top"
                Margin="0,0,0,8">
            <TextBlock Style="{DynamicResource FlowBlox.DialogDescriptionText}" Text="{x:Static resources:EditProjectVersionMetadataWindow.Header_Description}" />
        </Border>

        <!-- Main layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,6">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0"
                           Content="{x:Static resources:EditProjectVersionMetadataWindow.Label_Version}"
                           FontWeight="DemiBold"
                           Margin="0,0,0,5" />

                    <TextBox Grid.Row="1"
                         Text="{Binding VersionText, Mode=OneWay}"
                         IsReadOnly="True"
                         Margin="0,0,0,12" />

                    <Label Grid.Row="2"
                           Content="{x:Static resources:EditProjectVersionMetadataWindow.Label_Comment}"
                           FontWeight="DemiBold"
                           Margin="0,0,0,5" />

                    <TextBox Grid.Row="3"
                             Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="160"
                             Margin="0,0,0,12"
                             mah:TextBoxHelper.Watermark="{x:Static resources:EditProjectVersionMetadataWindow.Placeholder_Comment}" />
                </Grid>
            </ScrollViewer>

            <!-- Error footer -->
            <Border Grid.Row="1"
                    Background="#FFFCE8E8"
                    BorderBrush="#FFE6A3A3"
                    BorderThickness="1"
                    Padding="12"
                    CornerRadius="4"
                    Margin="0,12,0,0"
                    Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibilityConverter}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                Width="18"
                                                Height="18"
                                                Margin="0,2,10,0"
                                                Foreground="#FF8A1F1F"
                                                VerticalAlignment="Top"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorText}"
                               Foreground="#FF8A1F1F"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">

                <Button Content="{x:Static resources:EditProjectVersionMetadataWindow.Button_Back}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"/>

                <Button Content="{x:Static resources:EditProjectVersionMetadataWindow.Button_Save}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Save}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        IsDefault="True"/>
            </StackPanel>

        </Grid>
    </DockPanel>
</mah:MetroWindow>
