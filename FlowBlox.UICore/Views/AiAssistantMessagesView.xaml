<UserControl x:Class="FlowBlox.UICore.Views.AiAssistantMessagesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <DataTemplate x:Key="MessageCard">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Type}" FontSize="10" Foreground="#FF2F6DB3" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <icons:PackIconMaterial Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,5,0" ToolTip="{Binding Status}" />
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#FF65737E" />
                </StackPanel>
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ResponsePreview}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasResponse, Converter={StaticResource VisibleIfTrue}}" />
                <TextBlock Text="{Binding TokensText}" FontSize="11" Foreground="#FF65737E" Margin="0,8,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <views:AiAssistantDebugSelectionHeader />
        <views:AiAssistantDebugCardList Grid.Row="1" CardTemplate="{StaticResource MessageCard}" />
    </Grid>
</UserControl>
