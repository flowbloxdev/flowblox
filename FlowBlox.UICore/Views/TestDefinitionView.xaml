<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.Views.TestDefinitionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:FlowBlox.UICore.ViewModels"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters.TestDefinition"
    xmlns:globalConverters="clr-namespace:FlowBlox.UICore.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:coreEnums="clr-namespace:FlowBlox.Core.Enums;assembly=FlowBlox.Core"
    Title="{x:Static resources:TestDefinitionView.Title}"
    Height="900" Width="1220"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewModel:TestDefinitionViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/HostedControlStyles.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/PropertyViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <globalConverters:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>
            <converters:ExpectationConditionConverter x:Key="ExpectationConditionConverter"/>
            <converters:LogLevelToIconConverter x:Key="LogLevelToIconConverter"/>
            <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>
            <converters:RuntimeLogsToVisibilityConverter x:Key="RuntimeLogsToVisibilityConverter"/>
            <converters:TestResultsToVisibilityConverter x:Key="TestResultsToVisibilityConverter"/>
            <converters:UserInputEnabledConverter x:Key="UserInputEnabledConverter"/>
            <converters:MultilineTextVisibilityConverter x:Key="MultilineTextVisibilityConverter"/>
            <converters:FlowBlockToVisibilityConverter x:Key="FlowBlockToVisibilityConverter"/>
            <converters:TabControlVisibilityConverter x:Key="TabControlVisibilityConverter"/>
            <globalConverters:CollectionContainsToVisibilityConverter x:Key="CollectionContainsToVisibilityConverter"/>
            <viewModel:TestDefinitionViewModel x:Key="TestDefinitionViewModel"/>
            <converters:IndexDisplayConverter x:Key="IndexDisplayConverter"/>
            <Style x:Key="TestDefinitionView.ValidationRow"
                   TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="3" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UIHasFlowBlockValidationErrors}" Value="True">
                        <Setter Property="BorderBrush" Value="#FFD05A5A" />
                        <Setter Property="Background" Value="#18FCE8E8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{DynamicResource FlowBlox.DialogHeader}"
                Margin="10,10,10,0">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="FlaskOutline"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}"/>
                <TextBlock Text="{x:Static resources:TestDefinitionView.Header_Title_Main}"
                           Style="{DynamicResource FlowBlox.DialogHeaderTitle}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="10,0,10,0">
            <Border Style="{DynamicResource FlowBlox.DialogDescription}">
                <TextBlock Text="{Binding HeaderDescription}"
                           Style="{DynamicResource FlowBlox.DialogDescriptionText}"/>
            </Border>

            <Expander Header="{x:Static resources:TestDefinitionView.Expander_TestCaseHelp_Header}"
                      IsExpanded="False"
                      MaxHeight="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,5">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="InformationOutline" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_TestCaseHelp_Note1}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Margin="0,0,8,0" VerticalAlignment="Top" Foreground="#D97706"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_TestCaseHelp_Note2}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="PlayCircleOutline" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_TestCaseHelp_Note3}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="FlaskOutline" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_TestCaseHelp_Note4}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Expander>

            <Expander Header="{x:Static resources:TestDefinitionView.Expander_GeneratorHints_Header}"
                      Margin="0,10,0,0"
                      IsExpanded="False"
                      MaxHeight="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,5">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="InformationOutline" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_GeneratorHints_Text}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" Margin="0,0,8,0" VerticalAlignment="Top" Foreground="#D97706"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_GeneratorHints_Note1}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="FlaskOutline" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_GeneratorHints_Note2}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="TargetVariant" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_GeneratorHints_Note3}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="StarFourPointsOutline" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_GeneratorHints_Note4}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" Margin="0,0,8,0" VerticalAlignment="Top" Foreground="#D97706"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Static resources:TestDefinitionView.Expander_GeneratorHints_Note5}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10">
            <Label Content="{x:Static resources:TestDefinitionView.Label_Name}" />
            <TextBox Text="{Binding TestDefinition.Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding TestDefinition.RequiredForExecution}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <Label Content="{x:Static resources:TestDefinitionView.Label_RequiredForExecution}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <CheckBox IsChecked="{Binding HideLastLayerNeighbours}"
                          IsEnabled="{Binding CanToggleHideLastLayerNeighbours}"
                          Margin="0,0,5,0"
                          VerticalAlignment="Center"/>
                <Label Content="{x:Static resources:TestDefinitionView.Label_HideLastLayerNeighbours}"
                       VerticalAlignment="Center"
                       ToolTip="{x:Static resources:TestDefinitionView.Label_HideLastLayerNeighbours_Tooltip}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="datasetsScrollViewer" Grid.Row="3" Margin="10">
            <StackPanel>
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" SharedSizeGroup="col1"/>
                            <ColumnDefinition Width="100" SharedSizeGroup="col2"/>
                            <ColumnDefinition Width="150" SharedSizeGroup="col3"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="col4"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="col5"/>
                            <ColumnDefinition Width="250" SharedSizeGroup="col6"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static resources:TestDefinitionView.Text_FlowBlock}" FontWeight="Bold" Grid.Column="0" Margin="0,0,5,0"/>
                        <GridSplitter Grid.Column="0" Width="2" Margin="1 0 1 0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>
                        <TextBlock Text="{x:Static resources:TestDefinitionView.Text_Execute}" FontWeight="Bold" Grid.Column="1" Margin="0,0,5,0"/>
                        <GridSplitter Grid.Column="1" Width="2" Margin="1 0 1 0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>
                        <TextBlock Text="{x:Static resources:TestDefinitionView.Text_FieldLabel}" FontWeight="Bold" Grid.Column="2" Margin="0,0,5,0"/>
                        <GridSplitter Grid.Column="2" Width="2" Margin="1 0 1 0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="3" Margin="0,0,5,0">
                            <TextBlock Text="{x:Static resources:TestDefinitionView.Text_SelectionMode}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource PropertyView.HelpIconBorderStyle}"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="?"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White" />
                                <Border.ToolTip>
                                    <ToolTip Style="{StaticResource PropertyView.HelpToolTipStyle}"
                                             Content="{x:Static resources:TestDefinitionView.Text_SelectionMode_InfoTooltip}" />
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>
                        <GridSplitter Grid.Column="3" Width="2" Margin="1 0 1 0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>
                        <TextBlock Text="{x:Static resources:TestDefinitionView.Text_UserInputFieldValue}" FontWeight="Bold" Grid.Column="4" Margin="0,0,5,0"/>
                        <GridSplitter Grid.Column="4" Width="2" Margin="1 0 1 0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>
                        <TextBlock Text="{x:Static resources:TestDefinitionView.Text_TestExpectations}" FontWeight="Bold" Grid.Column="5" Margin="0,0,5,0"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SortedEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,7"
                                        Style="{StaticResource TestDefinitionView.ValidationRow}"
                                        Visibility="{Binding UIIsVisibleInCurrentContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" SharedSizeGroup="col1"/>
                                        <ColumnDefinition Width="100" SharedSizeGroup="col2"/>
                                        <ColumnDefinition Width="150" SharedSizeGroup="col3"/>
                                        <ColumnDefinition Width="230" SharedSizeGroup="col4"/>
                                        <ColumnDefinition Width="200" SharedSizeGroup="col5"/>
                                        <ColumnDefinition Width="250" SharedSizeGroup="col6"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FlowBlock.Name, ValidatesOnNotifyDataErrors=False}" VerticalAlignment="Center"/>
                                        <Border Width="18"
                                                Height="18"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                Visibility="{Binding UIIsTargetFlowBlock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.ToolTip>
                                                <ToolTip Style="{StaticResource PropertyView.HelpToolTipStyle}"
                                                         Content="{x:Static resources:TestDefinitionView.Icon_TargetFlowBlock_Tooltip}" />
                                            </Border.ToolTip>
                                            <iconPacks:PackIconMaterial Kind="TargetVariant"
                                                                        Width="16"
                                                                        Height="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center"
                                                                        Foreground="#1565C0" />
                                        </Border>
                                        <Border Width="18"
                                                Height="18"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                Visibility="{Binding UIAssociatedFlowBlockRequiredForExecution, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <ToolTip.Style>
                                                        <Style TargetType="ToolTip" BasedOn="{StaticResource PropertyView.HelpToolTipStyle}">
                                                            <Setter Property="Content" Value="{x:Static resources:TestDefinitionView.Icon_AssociatedFlowBlockRequiredForExecution_Tooltip}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UIAssociatedFlowBlockRequirementSatisfied}" Value="True">
                                                                    <Setter Property="Content" Value="{x:Static resources:TestDefinitionView.Icon_AssociatedFlowBlockRequiredForExecution_Configured_Tooltip}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToolTip.Style>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <iconPacks:PackIconMaterial Width="16"
                                                                        Height="16"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial.Style>
                                                    <Style TargetType="{x:Type iconPacks:PackIconMaterial}">
                                                        <Setter Property="Kind" Value="LinkVariant" />
                                                        <Setter Property="Foreground" Value="#7B1FA2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UIAssociatedFlowBlockRequirementSatisfied}" Value="True">
                                                                <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconMaterial.Style>
                                            </iconPacks:PackIconMaterial>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding Execute, ValidatesOnNotifyDataErrors=False}" Grid.Column="1"
                                              VerticalAlignment="Top" 
                                              Visibility="{Binding FlowBlock, Converter={StaticResource FlowBlockToVisibilityConverter}, ValidatesOnNotifyDataErrors=False}"
                                              Margin="0 5 0 0">
                                    </CheckBox>
                                    <ItemsControl ItemsSource="{Binding FlowBloxTestConfigurations, ValidatesOnNotifyDataErrors=False}" Grid.Column="2" Grid.ColumnSpan="4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0 0 0 5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" SharedSizeGroup="col3"/>
                                                        <ColumnDefinition Width="230" SharedSizeGroup="col4"/>
                                                        <ColumnDefinition Width="200" SharedSizeGroup="col5"/>
                                                        <ColumnDefinition Width="250" SharedSizeGroup="col6"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Column 0 -->
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FieldElement.Name}" VerticalAlignment="Center"/>
                                                        <Border Width="18"
                                                                Height="18"
                                                                Margin="5,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                Visibility="{Binding UIRequiredForExecution, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Border.ToolTip>
                                                                <ToolTip>
                                                                    <ToolTip.Style>
                                                                        <Style TargetType="ToolTip" BasedOn="{StaticResource PropertyView.HelpToolTipStyle}">
                                                                            <Setter Property="Content" Value="{x:Static resources:TestDefinitionView.Icon_UIRequiredForExecution_FieldConfiguration_Tooltip}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UIRequirementSatisfied}" Value="True">
                                                                                    <Setter Property="Content" Value="{x:Static resources:TestDefinitionView.Icon_UIRequiredForExecution_FieldConfiguration_Configured_Tooltip}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ToolTip.Style>
                                                                </ToolTip>
                                                            </Border.ToolTip>
                                                            <iconPacks:PackIconMaterial Width="16"
                                                                                        Height="16"
                                                                                        VerticalAlignment="Center"
                                                                                        HorizontalAlignment="Center">
                                                                <iconPacks:PackIconMaterial.Style>
                                                                    <Style TargetType="{x:Type iconPacks:PackIconMaterial}">
                                                                        <Setter Property="Kind" Value="AlertCircleOutline" />
                                                                        <Setter Property="Foreground" Value="#E65100" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UIRequirementSatisfied}" Value="True">
                                                                                <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </iconPacks:PackIconMaterial.Style>
                                                            </iconPacks:PackIconMaterial>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Column 1 -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,5,0">
                                                        <ComboBox SelectedItem="{Binding SelectionMode, ValidatesOnNotifyDataErrors=False}"
                                                              ItemsSource="{Binding PossibleSelectionModes, ValidatesOnNotifyDataErrors=False}"
                                                              VerticalAlignment="Center" Margin="0 0 0 5">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <TextBox Text="{Binding Index, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,0,0"
                                                             mah:TextBoxHelper.Watermark="{x:Static resources:TestDefinitionView.Text_SelectionMode_Index_Watermark}"
                                                             Visibility="{Binding IsIndexVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <!-- Column 2 -->
                                                    <Grid Grid.Column="2"
                                                      VerticalAlignment="Top"
                                                      IsEnabled="{Binding SelectionMode, Converter={StaticResource UserInputEnabledConverter}, ValidatesOnNotifyDataErrors=False}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Grid.Column="0" Margin="0,0,5,0">
                                                            <TextBox x:Name="UserInputTextBox"
                                                                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                                                                     Height="24"
                                                                     MaxLines="1"
                                                                     TextWrapping="NoWrap"
                                                                     VerticalContentAlignment="Center"
                                                                     Visibility="{Binding UserInput, Converter={StaticResource MultilineTextVisibilityConverter}, ConverterParameter=SingleLine, ValidatesOnNotifyDataErrors=False}" />

                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding UserInput, Converter={StaticResource MultilineTextVisibilityConverter}, ValidatesOnNotifyDataErrors=False}">
                                                                <iconPacks:PackIconMaterial Kind="InformationOutline"
                                                                                            Margin="0,0,6,0"
                                                                                            VerticalAlignment="Center"
                                                                                            Style="{StaticResource FlowBlox.EmptyStateIconStyle}" />
                                                                <TextBlock Text="{x:Static resources:TestDefinitionView.Text_EditInEditor}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Style="{StaticResource FlowBlox.EmptyStateTextStyle}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Button Grid.Column="1"
                                                            Margin="0,0,5,0"
                                                            Click="InsertFieldPlaceholderButton_Click"
                                                            Visibility="{Binding UserInput, Converter={StaticResource MultilineTextVisibilityConverter}, ConverterParameter=SingleLine, ValidatesOnNotifyDataErrors=False}">
                                                            <iconPacks:PackIconMaterial Kind="Variable" Width="14" Height="14" Foreground="#2F6DB3"/>
                                                        </Button>

                                                        <Button Grid.Column="2"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.EditContentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}">
                                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Column 3 -->
                                                    <Grid Grid.Column="3"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding Path=DataContext.FlowBlock, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid, AncestorLevel=2}, Converter={StaticResource FlowBlockToVisibilityConverter}, ValidatesOnNotifyDataErrors=False}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0"
                                                             Text="{Binding ExpectationConditions, Converter={StaticResource ExpectationConditionConverter}, ValidatesOnNotifyDataErrors=False}"
                                                             VerticalAlignment="Center"
                                                             IsReadOnly="True"
                                                             Margin="0,0,5,0" />

                                                        <Button Grid.Column="1"
                                                            Content="..." 
                                                            Command="{Binding DataContext.EditConditionsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                                            CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- TabControl for Test Results and Runtime Logs -->
        <TabControl Grid.Row="4" Margin="10" SelectedIndex="{Binding SelectedResultTabIndex, Mode=TwoWay}">

            <TabItem Header="{x:Static resources:TestDefinitionView.TabItem_Expectations}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClipboardTextOutline"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="#3A6EA5"/>
                            <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" Padding="0,5"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>

                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- SelectedConfiguration -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal" 
                                Margin="0,0,0,8" 
                                ToolTip="{x:Static resources:TestDefinitionView.StackPanel_SelectedConfiguration_Tooltip}">
                        <TextBlock VerticalAlignment="Center"
                           Text="{x:Static resources:TestDefinitionView.Label_SelectedConfiguration}"
                           Margin="0,0,8,0"/>
                        <ComboBox Width="380"
                          ItemsSource="{Binding Configurations}"
                          SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FieldElement.Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Toolbar -->
                    <ToolBar Grid.Row="1">
                        <Button ToolTip="{x:Static resources:TestDefinitionView.Toolbar_Add}"
                                Command="{Binding AddExpectationCommand}">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Foreground="DarkGreen" />
                        </Button>
                        <Button ToolTip="{x:Static resources:TestDefinitionView.Toolbar_Delete}"
                                Command="{Binding DeleteExpectationCommand}"
                                CommandParameter="{Binding SelectedExpectation}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" />
                        </Button>
                    </ToolBar>

                    <!-- ExpectationConditions -->
                    <DataGrid Grid.Row="2"
                      x:Name="expectationsGrid"
                      ItemsSource="{Binding SelectedConfiguration.ExpectationConditions}"
                      SelectedItem="{Binding SelectedExpectation, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="True"
                      IsReadOnly="False">

                        <!-- ExpectationTarget -->
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static resources:TestDefinitionView.Column_ExpectationTarget}" Width="Auto" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <Binding Path="ExpectationConditionTarget" Converter="{StaticResource EnumDisplayNameConverter}"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding ExpectationConditionTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.ExpectationTargets, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Index -->
                            <DataGridTemplateColumn Header="{x:Static resources:TestDefinitionView.Column_Index}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource IndexDisplayConverter}">
                                                    <Binding Path="ExpectationConditionTarget"/>
                                                    <Binding Path="Index"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExpectationConditionTarget}"
                                                                     Value="{x:Static coreEnums:ExpectationConditionTarget.ValueAtIndex}">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Operator -->
                            <DataGridTemplateColumn Header="{x:Static resources:TestDefinitionView.Column_Operator}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <Binding Path="Operator" Converter="{StaticResource EnumDisplayNameConverter}"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Operator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   ItemsSource="{Binding DataContext.ComparisonOperators, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Value -->
                            <DataGridTextColumn Header="{x:Static resources:TestDefinitionView.Column_Value}"
                                        Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static resources:TestDefinitionView.TabItem_RuntimeLogs}" Visibility="{Binding RuntimeLogs, Converter={StaticResource RuntimeLogsToVisibilityConverter}}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TextBoxSearchOutline"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="#3A6EA5"/>
                            <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" Padding="0,5"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <ListView ItemsSource="{Binding RuntimeLogs}" Background="White">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static resources:TestDefinitionView.MenuItem_OpenInEditor}" 
                              Command="{Binding OpenInEditorCommand, Source={StaticResource TestDefinitionViewModel}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconModern Kind="Edit" Width="14" Height="14" Margin="0,0,5,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static resources:TestDefinitionView.GridViewColumn_Timestamp}" DisplayMemberBinding="{Binding Timestamp}"/>
                            <GridViewColumn Header="{x:Static resources:TestDefinitionView.GridViewColumn_LogLevel}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconModern Kind="{Binding LogLevel, Converter={StaticResource LogLevelToIconConverter}}"
                                                                      Foreground="{Binding LogLevel, Converter={StaticResource LogLevelToBrushConverter}}"
                                                                      Width="16"
                                                                      Height="16"
                                                                      Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding LogLevel}"
                                                       Foreground="{Binding LogLevel, Converter={StaticResource LogLevelToBrushConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static resources:TestDefinitionView.GridViewColumn_Message}" DisplayMemberBinding="{Binding Message}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="{x:Static resources:TestDefinitionView.TabItem_TestResults}" Visibility="{Binding TestResults, Converter={StaticResource TestResultsToVisibilityConverter}}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TableLarge"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="#3A6EA5"/>
                            <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" Padding="0,5"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <DataGrid x:Name="testResultsDataGrid" ItemsSource="{Binding TestResults}" AutoGenerateColumns="False">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static resources:TestDefinitionView.MenuItem_OpenInEditor}" 
                                      Command="{Binding OpenInEditorCommand, Source={StaticResource TestDefinitionViewModel}}" 
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconModern Kind="Edit" Width="14" Height="14" Margin="5,0,5,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="5"
                Background="#FFFCE8E8"
                BorderBrush="#FFD05A5A"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="10,4,10,0"
                MaxHeight="140"
                Visibility="{Binding HasValidationMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ValidationMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,1,8,0"
                                                            Foreground="#FF8A1F1F"
                                                            VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding}"
                                           Foreground="#FF8A1F1F"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Command="{Binding ExecuteTestCommand}"
                    IsEnabled="{Binding CanExecute}"
                    MinWidth="112"
                    Height="32"
                    Padding="12,5"
                    Margin="5">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Play"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Execute}"/>
                    <TextBlock Text="{x:Static resources:TestDefinitionView.Button_Execute}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Content="{x:Static resources:TestDefinitionView.Button_Back}"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}" />

            <Button Content="{x:Static resources:TestDefinitionView.Button_Apply}"
                    Click="ApplyButton_Click"
                    IsEnabled="{Binding CanApply}"
                    Style="{StaticResource FlowBlox.WindowActionButton.Apply}" />

            <Button Content="{x:Static resources:TestDefinitionView.Button_Save}"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    IsEnabled="{Binding CanApply}"
                    Style="{StaticResource FlowBlox.WindowActionButton.Save}" />
        </StackPanel>

    </Grid>
</mah:MetroWindow>
