<mah:MetroWindow x:Class="FlowBlox.UICore.Views.LocalAISetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:texts="clr-namespace:FlowBlox.UICore.Resources"
    Style="{DynamicResource FlowBlox.Window}"
    Title="{x:Static texts:LocalAISetupWindow.Title}"
    Width="880" Height="760" MinWidth="680" MinHeight="520" MaxHeight="850"
    ShowMinButton="False" ShowMaxRestoreButton="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogHeader}">
            <StackPanel Orientation="Horizontal">
                <icons:PackIconMaterial Kind="Brain" Width="32" Height="32" Margin="0,0,10,0"
                                       Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}" />
                <TextBlock Text="{x:Static texts:LocalAISetupWindow.Title}"
                           Style="{DynamicResource FlowBlox.DialogHeaderTitle}" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogDescription}">
            <TextBlock Text="{x:Static texts:LocalAISetupWindow.Description}"
                       Style="{DynamicResource FlowBlox.DialogDescriptionText}" />
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource FlowBlox.Brush.Border}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static texts:LocalAISetupWindow.Back}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                        mah:ControlsHelper.ContentCharacterCasing="Normal"
                        IsEnabled="{Binding CanClose}" IsCancel="True" Click="Back_Click" />
                <Button Style="{StaticResource FlowBlox.WindowActionButton}"
                        mah:ControlsHelper.ContentCharacterCasing="Normal"
                        Background="#286A9E" Foreground="White" BorderBrush="#286A9E"
                        IsDefault="True" IsEnabled="{Binding CanConfigure}" Click="Configure_Click">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="AutoFix" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="{x:Static texts:LocalAISetupWindow.Configure}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,12">
                <TextBlock Text="{x:Static texts:LocalAISetupWindow.SelectModel}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                         IsEnabled="{Binding CanChangeSelection}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="{Binding ModelColumns}" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="#F7F9FB" BorderBrush="#D5DEE7"
                                                BorderThickness="1" CornerRadius="5" Padding="14">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#397EAD" />
                                                <Setter TargetName="Card" Property="Background" Value="#EAF3FA" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#739BB9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="Brain" Width="24" Height="24" Foreground="#397EAD" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,9,0,0" Foreground="#40566B" />
                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,9,0,0" Foreground="#64788B" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{x:Static texts:LocalAISetupWindow.MemoryNote}" TextWrapping="Wrap"
                           Foreground="#64788B" FontSize="12" Margin="0,3,0,18" />
                <TextBlock Text="{x:Static texts:LocalAISetupWindow.Steps}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListView ItemsSource="{Binding Steps}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="{x:Static texts:LocalAISetupWindow.StepColumn}" Width="175">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Title}" Width="155" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static texts:LocalAISetupWindow.DescriptionColumn}" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Description}" Width="300" TextWrapping="Wrap" Foreground="#64788B" Margin="0,6" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static texts:LocalAISetupWindow.OverwriteColumn}" Width="125">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding OverwriteExisting}"
                                                  Visibility="{Binding CanOverwrite, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  IsEnabled="{Binding DataContext.CanChangeSelection, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  AutomationProperties.Name="{Binding Title}"
                                                  ToolTip="{x:Static texts:LocalAISetupWindow.OverwriteExistingTooltip}" HorizontalAlignment="Center" Margin="0,6" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static texts:LocalAISetupWindow.StatusColumn}" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,6">
                                            <icons:PackIconMaterial Kind="{Binding Icon}" Foreground="{Binding Color}" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Status}" Width="95" TextWrapping="Wrap" Foreground="{Binding Color}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</mah:MetroWindow>
