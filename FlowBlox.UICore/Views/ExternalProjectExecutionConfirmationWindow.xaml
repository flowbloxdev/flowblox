<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}" x:Class="FlowBlox.UICore.Views.ExternalProjectExecutionConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Confirm_Title}"
        Width="620" Height="330" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconMaterial Kind="ShieldAlertOutline"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Foreground="DarkGoldenrod" />
            <TextBlock Text="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Confirm_Description}"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="14" />
        </Grid>
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" Background="#FFF5E6" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Reason}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ReasonText" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ProjectFileText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" />

        <Expander Grid.Row="3" Margin="0,12,0,0" IsExpanded="False"
                  Header="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_InputParameters}"
                  BorderBrush="{DynamicResource FlowBlox.Brush.Border}"
                  mah:HeaderedControlHelper.HeaderBackground="{DynamicResource FlowBlox.Brush.InformationHeader}"
                  mah:HeaderedControlHelper.HeaderForeground="{DynamicResource FlowBlox.Brush.InformationHeaderText}">
            <DataGrid x:Name="InputParametersGrid" Margin="0,6,0,0" MaxHeight="260"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_ParameterName}"
                                        Binding="{Binding Key}" Width="180" />
                    <DataGridTemplateColumn Header="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_ParameterValue}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Margin="4,2" Padding="4"
                                            Click="ViewParameterContent_Click"
                                            ToolTip="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_ViewParameterContent}">
                                        <iconPacks:PackIconMaterial Kind="EyeOutline" Width="14" Height="14" Foreground="#2F6DB3" />
                                    </Button>
                                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             MaxHeight="60" VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ReviewButton"
                    Content="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Review}"
                    Style="{StaticResource FlowBlox.WindowActionButton}"
                    Click="ReviewButton_Click" />
            <Button Content="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Cancel}"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button x:Name="AlwaysAllowButton"
                    Style="{StaticResource FlowBlox.WindowActionButton}"
                    Click="AlwaysAllowButton_Click">
                <Button.ToolTip>
                    <ToolTip Style="{StaticResource FlowBlox.ToolTipStyle}"
                             Content="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_ApprovalPersistence}" />
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ShieldCheckOutline"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Apply}" />
                    <AccessText Text="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_AlwaysAllow}"
                                VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="AllowOnceButton"
                    mah:ControlsHelper.ContentCharacterCasing="Normal"
                    Style="{StaticResource FlowBlox.WindowActionButton}"
                    IsDefault="True"
                    Click="ExecuteButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="PlayCircleOutline"
                                                Style="{StaticResource FlowBlox.WindowActionIcon.Apply}" />
                    <AccessText Text="{x:Static resources:AiAssistantChatView.Message_ExternalProjectExecution_Execute}"
                                VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
