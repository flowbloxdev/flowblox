<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}" x:Class="FlowBlox.UICore.Views.AiAssistantDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    Title="{Binding Title}" Height="800" Width="1280" MinHeight="560" MinWidth="760"
    WindowStartupLocation="CenterOwner"
    PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
                <ResourceDictionary Source="AiAssistantDebugCardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
            <Style x:Key="RuntimeButton" TargetType="Button"
                   BasedOn="{StaticResource FlowBlox.WindowActionButton}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource FlowBlox.Icon.DisabledBrush}" />
                        <Setter Property="Background" Value="#FFF3F4F6" />
                        <Setter Property="BorderBrush" Value="#FFD1D5DB" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RuntimeContinueButton" TargetType="Button" BasedOn="{StaticResource RuntimeButton}">
                <Setter Property="Foreground" Value="#FF247145" />
                <Setter Property="Background" Value="#FFEAF5EE" />
                <Setter Property="BorderBrush" Value="#FFB8D8C4" />
            </Style>
            <Style x:Key="RuntimePauseButton" TargetType="Button" BasedOn="{StaticResource RuntimeButton}">
                <Setter Property="Foreground" Value="#FF946000" />
                <Setter Property="Background" Value="#FFFFF6DF" />
                <Setter Property="BorderBrush" Value="#FFE5CF98" />
            </Style>
            <Style x:Key="RuntimeStopButton" TargetType="Button" BasedOn="{StaticResource RuntimeButton}">
                <Setter Property="Foreground" Value="#FFB33434" />
                <Setter Property="Background" Value="#FFFBECEC" />
                <Setter Property="BorderBrush" Value="#FFE4BABA" />
            </Style>
            <Style x:Key="RuntimeIcon" TargetType="icons:PackIconMaterial"
                   BasedOn="{StaticResource FlowBlox.ToolbarIconBase}">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#FFEDF3F9" Padding="12" CornerRadius="6" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ToolBar Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                         ToolBarTray.IsLocked="True" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RuntimeLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Command="{Binding Runtime.ContinueCommand}" Style="{StaticResource RuntimeContinueButton}"
                            ToolTip="{Binding Runtime.ContinueTooltip}"
                            AutomationProperties.Name="{Binding Runtime.ContinueButtonText}">
                        <icons:PackIconMaterial Kind="Play" Style="{StaticResource RuntimeIcon}" />
                    </Button>
                    <Button Command="{Binding Runtime.PauseCommand}" Style="{StaticResource RuntimePauseButton}"
                            ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_Pause}"
                            AutomationProperties.Name="{Binding Runtime.PauseButtonText}">
                        <icons:PackIconMaterial Kind="Pause" Style="{StaticResource RuntimeIcon}" />
                    </Button>
                    <Button Command="{Binding Runtime.StopCommand}" Style="{StaticResource RuntimeStopButton}"
                            ToolTip="{x:Static resources:AiAssistantChatView.Tooltip_Stop}"
                            AutomationProperties.Name="{x:Static resources:AiAssistantChatView.Button_Stop}">
                        <icons:PackIconMaterial Kind="Stop" Style="{StaticResource RuntimeIcon}" />
                    </Button>
                </ToolBar>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ContextStatistics}"
                           Foreground="#FF65737E" TextWrapping="Wrap" Margin="0,4,0,0" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*" MinWidth="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.1*" MinWidth="210" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.8*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" BorderThickness="0"
                     Background="Transparent" ItemContainerStyle="{StaticResource DebugCardItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#FF65737E" Margin="0,6,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#FFE2E6EA" />
            <ContentControl Grid.Column="2" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value><DataTemplate><views:AiAssistantMessagesView /></DataTemplate></Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUsageTopic}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><views:AiAssistantUsageView /></DataTemplate></Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSystemMessagesTopic}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><views:AiAssistantSystemMessagesView /></DataTemplate></Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="#FFE2E6EA" />
            <Grid Grid.Column="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="6,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionTokens}" Foreground="#FF65737E" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <views:InnerContentView Grid.Row="1" DataContext="{Binding Editor}" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{x:Static resources:PropertyWindow.Back}"
                    IsCancel="True"
                    Click="BackButton_Click"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
