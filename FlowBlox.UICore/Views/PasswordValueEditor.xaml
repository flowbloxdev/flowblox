<UserControl x:Class="FlowBlox.UICore.Views.PasswordValueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/PropertyViewStyles.xaml" />
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/PasswordEditorStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <PasswordBox x:Name="MaskedEditor" PasswordChanged="Password_Changed" MinHeight="26" />
    <TextBox x:Name="RevealedEditor" TextChanged="Text_Changed" Visibility="Collapsed"
             Style="{StaticResource PropertyView.TextEditorStyle}" />
    <ToggleButton x:Name="MaskButton" Grid.Column="1" IsChecked="True" Checked="Mask_Changed" Unchecked="Mask_Changed"
                  Style="{StaticResource FlowBlox.PasswordVisibilityToggle}" Width="26" Height="26" Margin="4,0,0,0"
                  AutomationProperties.Name="{x:Static resources:VaultWindow.ShowValue}">
      <icons:PackIconMaterial Kind="EyeOutline" Width="16" Height="16" />
    </ToggleButton>
  </Grid>
</UserControl>
