<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <ResourceDictionary.MergedDictionaries>
        <!-- Makes the explicit MahApps button base style available inside this standalone dictionary. -->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.Buttons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================== -->
    <!-- FlowBlox Custom Styles -->
    <!-- ====================== -->

    <!-- Shared interaction colors for dialog actions and hosted toolbar buttons. -->
    <Style x:Key="FlowBlox.ToolbarButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.ToolbarButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.ToolbarButtonHover}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FlowBlox.Brush.ToolbarButtonFocus}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.ToolbarButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared tooltip appearance for windows, hosted views, and generated controls. -->
    <Style x:Key="FlowBlox.ToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="MaxWidth" Value="460"/>
        <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.ToolTipBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.ToolTipText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FlowBlox.Brush.ToolTipBorder}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource FlowBlox.Thickness.ToolTipBorder}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource FlowBlox.CornerRadius.ToolTip}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}"
           BasedOn="{StaticResource FlowBlox.ToolTipStyle}"/>

    <!-- Compatibility key used by the Property and Test Definition views. -->
    <Style x:Key="PropertyView.HelpToolTipStyle"
           TargetType="{x:Type ToolTip}"
           BasedOn="{StaticResource FlowBlox.ToolTipStyle}"/>

    <!-- ========================================================= -->
    <!-- FlowBlox Toolbar Icon styling (PackIconMaterial)           -->
    <!-- Ensures proper disabled rendering (greyed out)             -->
    <!-- ========================================================= -->

    <!-- Neutral disabled icon brush (professional grey) -->
    <SolidColorBrush x:Key="FlowBlox.Icon.DisabledBrush" Color="#9AA3AF"/>

    <!-- Base style: enabled color comes from the derived style, disabled forces DisabledBrush -->
    <Style x:Key="FlowBlox.ToolbarIconBase"
       TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Opacity" Value="1"/>
        <!-- Default enabled foreground (can be overridden by derived styles) -->
        <Setter Property="Foreground" Value="#5C6B73"/>

        <Style.Triggers>
            <!-- IsEnabled is inherited from the parent Button -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource FlowBlox.Icon.DisabledBrush}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIconBase"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.ToolbarIconBase}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIcon.Save"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.WindowActionIconBase}">
        <Setter Property="Foreground" Value="#2E8B57"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIcon.Apply"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.WindowActionIcon.Save}"/>

    <Style x:Key="FlowBlox.WindowActionIcon.Back"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.WindowActionIconBase}">
        <Setter Property="Foreground" Value="#5C6B73"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIcon.Execute"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.WindowActionIconBase}">
        <Setter Property="Foreground" Value="#3A6EA5"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionIcon.Delete"
           TargetType="{x:Type iconPacks:PackIconMaterial}"
           BasedOn="{StaticResource FlowBlox.WindowActionIconBase}">
        <Setter Property="Foreground" Value="#B42318"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="FlowBlox.WindowActionButton.Back"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FlowBlox.WindowActionButton}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                        Style="{StaticResource FlowBlox.WindowActionIcon.Back}"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlowBlox.WindowActionButton.Apply"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FlowBlox.WindowActionButton}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Check"
                                                        Style="{StaticResource FlowBlox.WindowActionIcon.Apply}"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlowBlox.WindowActionButton.Save"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FlowBlox.WindowActionButton}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave"
                                                        Style="{StaticResource FlowBlox.WindowActionIcon.Save}"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlowBlox.WindowActionButton.Delete"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FlowBlox.WindowActionButton}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="DeleteOutline"
                                                        Style="{StaticResource FlowBlox.WindowActionIcon.Delete}"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keeps MahApps' SplitButton behavior while matching the regular window action buttons. -->
    <Style x:Key="FlowBlox.WindowActionSplitButton"
           TargetType="{x:Type mah:SplitButton}"
           BasedOn="{StaticResource {x:Type mah:SplitButton}}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Button.Border}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Button}"/>
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Button}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="3"/>
    </Style>

    <!-- Compact scroll bars used where content should stay visually lightweight. -->
    <Style x:Key="FlowBlox.ThinScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="#7F91A3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#5F7890"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="FlowBlox.ThinHorizontalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="2">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.Thumb>
                    <Thumb Style="{StaticResource FlowBlox.ThinScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="FlowBlox.ThinVerticalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="2">
            <Track x:Name="PART_Track"
                   Orientation="Vertical"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   IsDirectionReversed="True">
                <Track.Thumb>
                    <Thumb Style="{StaticResource FlowBlox.ThinScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Border>
    </ControlTemplate>

    <Style x:Key="FlowBlox.ThinScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="#E1E6EB"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="5"/>
                <Setter Property="MinHeight" Value="5"/>
                <Setter Property="Template" Value="{StaticResource FlowBlox.ThinHorizontalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="5"/>
                <Setter Property="MinWidth" Value="5"/>
                <Setter Property="Template" Value="{StaticResource FlowBlox.ThinVerticalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keeps tab headers on one line and exposes a compact horizontal scrollbar on overflow. -->
    <Style x:Key="FlowBlox.ScrollableHeaderTabControl"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource FlowBlox.ThinScrollBar}"/>
                            </ScrollViewer.Resources>
                            <TabPanel IsItemsHost="True" Margin="2,0"/>
                        </ScrollViewer>
                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
