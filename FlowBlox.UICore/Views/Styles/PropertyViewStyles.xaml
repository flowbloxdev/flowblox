<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.TextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="PropertyView.TextEditorStyle" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.EditorBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlowBlox.Brush.Border}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsLoaded, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True" />
                    <Condition Binding="{Binding AcceptsReturn, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyView.CodeEditorStyle" TargetType="avalonedit:TextEditor">
        <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.EditorBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FlowBlox.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="FontFamily" Value="JetBrains Mono" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="PropertyView.FieldSelectionIconStyle" TargetType="icons:PackIconMaterial">
        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.Accent}" />
    </Style>

    <Style x:Key="PropertyView.UnlinkIconStyle" TargetType="icons:PackIconMaterial">
        <Setter Property="Foreground" Value="#B91C1C" />
    </Style>

    <Style x:Key="PropertyView.LabelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.LabelBackground}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="PropertyView.LabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.LabelText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PropertyView.EditorContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="PropertyView.HelpIconBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.HelpBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FlowBlox.Brush.HelpBorder}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
</ResourceDictionary>
