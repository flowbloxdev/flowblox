<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
    x:Class="FlowBlox.UICore.Views.ProjectExecutionWindow"
    Title="{x:Static resources:ProjectLauncher.Title}"
    Style="{DynamicResource FlowBlox.Window}"
    Width="1020" Height="780" MinWidth="760" MinHeight="480"
    WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/PropertyViewStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Style x:Key="Execution.NoticeMarkdown" TargetType="{x:Type FlowDocument}" BasedOn="{x:Static md:MarkdownStyle.Standard}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="DarkSlateGray" />
        <Setter Property="PagePadding" Value="0" />
      </Style>
      <Style x:Key="Execution.SectionBorder" TargetType="Border" BasedOn="{StaticResource PropertyView.LabelBorderStyle}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="#CDDDEB" />
      </Style>
      <Style x:Key="Execution.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource PropertyView.LabelTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#244B66" />
      </Style>
      <Style x:Key="Execution.ParameterBorder" TargetType="Border" BasedOn="{StaticResource PropertyView.LabelBorderStyle}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="#EDF4F8" />
      </Style>
      <Style x:Key="Execution.ParameterLabel" TargetType="TextBlock" BasedOn="{StaticResource PropertyView.LabelTextStyle}">
        <Setter Property="Foreground" Value="#245369" />
      </Style>
      <Style x:Key="Execution.HistoryToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="#EAF0F5" />
        <Setter Property="Foreground" Value="#47758D" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="{TemplateBinding Background}" CornerRadius="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#D4E4F0" />
            <Setter Property="Foreground" Value="#173F5B" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter Property="Background" Value="#D4E4F0" />
            <Setter Property="Foreground" Value="#173F5B" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Execution.InputConfigurationsExpander" TargetType="Expander">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="HistoryContent" ContentSource="Content" Visibility="Collapsed" />
                <ToggleButton Grid.Column="1" Style="{StaticResource Execution.HistoryToggle}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ToolTip="{x:Static resources:ProjectLauncher.SavedConfigurations}"
                              AutomationProperties.Name="{x:Static resources:ProjectLauncher.SavedConfigurations}">
                  <icons:PackIconMaterial Width="12" Height="12"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                    <icons:PackIconMaterial.Style>
                      <Style TargetType="icons:PackIconMaterial">
                        <Setter Property="Kind" Value="ChevronRight" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                            <Setter Property="Kind" Value="ChevronLeft" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </icons:PackIconMaterial.Style>
                  </icons:PackIconMaterial>
                </ToggleButton>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="HistoryContent" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Execution.ConfigurationCard" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#244B66" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                      BorderBrush="#CFDCE5" BorderThickness="1" CornerRadius="0">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#EDF4FA" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="#DCEAF6" />
            <Setter Property="Foreground" Value="#173F5B" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="10">
    <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogHeader}">
      <TextBlock x:Name="ProjectTitle" Style="{DynamicResource FlowBlox.DialogHeaderTitle}" />
    </Border>
    <Border x:Name="ProjectDescriptionBox" DockPanel.Dock="Top" MaxHeight="100" Style="{DynamicResource FlowBlox.DialogDescription}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="ProjectDescription" Style="{DynamicResource FlowBlox.DialogDescriptionText}" />
      </ScrollViewer>
    </Border>
    <Expander x:Name="ProjectNoticeExpander" DockPanel.Dock="Top" Margin="0,0,0,8"
              Style="{StaticResource FlowBlox.InformationExpander}" Visibility="Collapsed">
      <Expander.Header>
        <StackPanel Orientation="Horizontal">
          <icons:PackIconMaterial Kind="LightbulbOutline" Width="16" Height="16" Margin="0,0,7,0" Foreground="{DynamicResource FlowBlox.Brush.ProjectNoteIcon}" />
          <TextBlock Text="{x:Static resources:ProjectLauncher.ProjectNotice}" Foreground="White" />
        </StackPanel>
      </Expander.Header>
      <Border Background="{DynamicResource FlowBlox.Brush.InformationBackground}"
              BorderBrush="{DynamicResource FlowBlox.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10">
        <md:MarkdownScrollViewer x:Name="ProjectNoticeText" MaxHeight="180"
                                 MarkdownStyle="{StaticResource Execution.NoticeMarkdown}"
                                 IsToolBarVisible="False" Background="Transparent" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
      </Border>
    </Expander>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray5}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <DockPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static resources:ProjectLauncher.Close}" IsCancel="True"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}" Click="Close_Click" />
            <Button x:Name="ExecuteButton" Style="{StaticResource FlowBlox.WindowActionButton}"
                    IsDefault="True" IsEnabled="False" Click="Execute_Click">
              <StackPanel Orientation="Horizontal">
                <icons:PackIconMaterial Kind="Play" Style="{StaticResource FlowBlox.WindowActionIcon.Apply}" />
                <AccessText Text="{x:Static resources:ProjectLauncher.Execute}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="TerminateButton" Style="{StaticResource FlowBlox.WindowActionButton}"
                    Visibility="Collapsed" Click="Terminate_Click">
              <StackPanel Orientation="Horizontal">
                <icons:PackIconMaterial Kind="Stop" Style="{StaticResource FlowBlox.WindowActionIconBase}" Foreground="IndianRed" />
                <AccessText Text="{x:Static resources:ProjectLauncher.TerminateProcess}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200" DockPanel.Dock="Bottom">
          <StackPanel Margin="4,8">
            <ContentControl x:Name="NotStartedHint" Content="{x:Static resources:ProjectLauncher.NotStarted}"
                            Style="{StaticResource FlowBlox.EmptyState}" Margin="0,12" />
      <ProgressBar x:Name="RunningIndicator" Style="{StaticResource FlowBlox.ProgressBar.Indeterminate}" Visibility="Collapsed" />
      <Border x:Name="StartedBox" Style="{StaticResource FlowBlox.NotificationBox.Information}" Margin="0,7,0,12" Visibility="Collapsed">
        <DockPanel>
          <icons:PackIconMaterial Kind="InformationOutline" Style="{StaticResource FlowBlox.NotificationIcon}" />
          <StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource FlowBlox.NotificationTitle}" />
            <TextBlock x:Name="RunnerProcessText" Style="{StaticResource FlowBlox.NotificationText}" Margin="0,4,0,0" Visibility="Collapsed" />
            <TextBlock Text="{x:Static resources:ProjectLauncher.Readonly}" Style="{StaticResource FlowBlox.NotificationText}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="CompletionBox" Style="{StaticResource FlowBlox.NotificationBox.Success}" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="CompletionTitle" Style="{StaticResource FlowBlox.NotificationTitle}" />
          <TextBlock x:Name="CompletionMessage" Style="{StaticResource FlowBlox.NotificationText}" Margin="0,5,0,0" />
          <TextBlock x:Name="LogLinkContainer" Margin="0,8,0,0" Visibility="Collapsed">
            <Hyperlink x:Name="LogLink" Click="OpenLog_Click">
              <Run Text="{x:Static resources:ProjectLauncher.OpenLog}" />
            </Hyperlink>
          </TextBlock>
          <TextBlock x:Name="LogUnavailableText" Text="{x:Static resources:ProjectLauncher.LogUnavailable}"
                     Style="{StaticResource FlowBlox.NotificationText}" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>

            <Expander x:Name="WarningsExpander" Header="{x:Static resources:ProjectLauncher.Warnings}" Visibility="Collapsed" Margin="0,8">
              <TextBox x:Name="WarningMessages" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
    <TabControl x:Name="ExecutionTabs">
      <TabItem x:Name="ConfigurationTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <icons:PackIconMaterial Kind="FormTextbox" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#1E88E5" />
            <TextBlock Text="{x:Static resources:ProjectLauncher.Inputs}" FontSize="15" FontWeight="SemiBold" Padding="0,5" />
          </StackPanel>
        </TabItem.Header>
<Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <Border Style="{StaticResource PropertyView.LabelBorderStyle}" Margin="0,8,0,4">
          <TextBlock Text="{x:Static resources:ProjectLauncher.InputPath}" Style="{StaticResource PropertyView.LabelTextStyle}" />
        </Border>
        <DockPanel>
          <Button x:Name="InputDirectoryButton" DockPanel.Dock="Right" Margin="6,0,0,0" Width="36"
                  ToolTip="{x:Static resources:ProjectLauncher.InputDirectory}">
            <icons:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource FlowBlox.ToolbarIconBase}" />
          </Button>
          <TextBox x:Name="InputPath" IsReadOnly="True" Style="{StaticResource PropertyView.TextEditorStyle}" />
        </DockPanel>
      </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Execution.SectionBorder}" Margin="0,8,0,5">
          <StackPanel Orientation="Horizontal">
            <icons:PackIconMaterial Kind="FormTextbox" Width="14" Height="14" Foreground="#1E88E5"
                                    VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{x:Static resources:ProjectLauncher.Parameters}" Style="{StaticResource Execution.SectionLabel}" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Expander x:Name="InputConfigurationsExpander" Grid.Column="0" ExpandDirection="Left" IsExpanded="True"
                    Style="{StaticResource Execution.InputConfigurationsExpander}"
                    Visibility="Collapsed" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Margin="0,0,10,0" ToolTip="{x:Static resources:ProjectLauncher.SavedConfigurations}"
                    AutomationProperties.Name="{x:Static resources:ProjectLauncher.SavedConfigurations}">
            <Border Width="216" BorderBrush="#D5DFE8" BorderThickness="0,0,1,0" Padding="0,0,8,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static resources:ProjectLauncher.SavedConfigurations}"
                           Style="{StaticResource Execution.ParameterLabel}" Margin="7,4,4,8" />
                <ListBox x:Name="ConfigurationList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="ConfigurationList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Execution.ConfigurationCard}" />
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{x:Static resources:ProjectLauncher.EditConfiguration}"
                                      Click="RenameConfiguration_Click"
                                      IsEnabled="{Binding Tag.CanRename, RelativeSource={RelativeSource Self}}"
                                      Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                              <MenuItem.Icon><icons:PackIconMaterial Kind="PencilOutline" Foreground="#526D82" /></MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="0,0,23,7"
                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                        <icons:PackIconMaterial Kind="{Binding IconKind}" Width="16" Height="16" Foreground="#526D82"
                                                ToolTip="{Binding Description}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="1" Text="{Binding FilledSummary}" FontSize="11" Foreground="#607383" />
                        <TextBlock Grid.Row="2" Text="{Binding RequiredSummary}" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap" ToolTip="{Binding MissingFields}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#3B875C" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMissingRequiredFields}" Value="True">
                                  <Setter Property="Foreground" Value="#A16B16" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </Expander>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Configuration">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Button x:Name="SaveConfigurationButton" Click="SaveConfiguration_Click" Style="{StaticResource FlowBlox.ToolbarButton}"
                  ToolTip="{x:Static resources:ProjectLauncher.SaveConfiguration}">
            <StackPanel Orientation="Horizontal">
              <icons:PackIconMaterial Kind="ContentSaveOutline" Width="16" Height="16" Foreground="#526D82" Margin="0,0,6,0" />
              <TextBlock Text="{x:Static resources:ProjectLauncher.SaveConfiguration}" />
            </StackPanel>
          </Button>
          <Button x:Name="ClearInputsButton" Click="ClearInputs_Click" Style="{StaticResource FlowBlox.ToolbarButton}" Visibility="Collapsed"
                  ToolTip="{x:Static resources:ProjectLauncher.ClearInputsTooltip}">
            <StackPanel Orientation="Horizontal">
              <icons:PackIconMaterial Kind="Restore" Width="16" Height="16" Foreground="#47758D" Margin="0,0,6,0" />
              <TextBlock Text="{x:Static resources:ProjectLauncher.ClearInputs}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <ContentControl x:Name="NoParametersHint" Content="{x:Static resources:ProjectLauncher.NoParameters}"
                        Style="{StaticResource FlowBlox.EmptyState}" Margin="4,10,4,16" Visibility="Collapsed" />
        <StackPanel x:Name="FieldsPanel" Margin="0,0,0,6" />
        <Expander x:Name="OptionOverridesExpander" Header="{x:Static resources:ProjectLauncher.OptionOverrides}"
                  IsExpanded="False" Margin="0,8,0,0"
                  BorderBrush="{DynamicResource FlowBlox.Brush.Border}"
                  mah:HeaderedControlHelper.HeaderBackground="{DynamicResource FlowBlox.Brush.InformationHeader}"
                  mah:HeaderedControlHelper.HeaderForeground="{DynamicResource FlowBlox.Brush.InformationHeaderText}">
        <StackPanel Margin="8">
        <StackPanel Orientation="Horizontal" Margin="0,6">
          <Button x:Name="AddOptionButton" ToolTip="{x:Static resources:ProjectLauncher.AddOption}" Click="AddOption_Click" Padding="6,3">
            <icons:PackIconMaterial Kind="Plus" Style="{StaticResource FlowBlox.WindowActionIcon.Apply}" Margin="0" />
          </Button>
          <Button x:Name="RemoveOptionButton" ToolTip="{x:Static resources:ProjectLauncher.RemoveOption}" Click="RemoveOption_Click" Padding="6,3" IsEnabled="False">
            <icons:PackIconMaterial Kind="Delete" Style="{StaticResource FlowBlox.WindowActionIcon.Delete}" Margin="0" />
          </Button>
        </StackPanel>
        <ContentControl Content="{x:Static resources:ProjectLauncher.NoOptionOverrides}" Margin="4,10,4,16">
          <ContentControl.Style>
            <Style TargetType="ContentControl" BasedOn="{StaticResource FlowBlox.EmptyState}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=OptionsGrid}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
        <DataGrid x:Name="OptionsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"
                  MinHeight="100" MaxHeight="240" SelectionChanged="OptionsGrid_SelectionChanged"
                  ToolTip="{x:Static resources:ProjectLauncher.OptionTooltip}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static resources:ProjectLauncher.Option}" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding AvailableOptionKeys}" SelectedItem="{Binding OptionKey, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding OptionKey}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static resources:ProjectLauncher.Value}" Width="*"
                                Binding="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
          </DataGrid.Columns>
        </DataGrid>
        </StackPanel>
        </Expander>
        </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
      </TabItem>
      <TabItem x:Name="ResultsTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <icons:PackIconMaterial Kind="Export" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#9270CC" />
            <TextBlock Text="{x:Static resources:ProjectLauncher.Outputs}" FontSize="15" FontWeight="SemiBold" Padding="0,5" />
          </StackPanel>
        </TabItem.Header>
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
        <Border Style="{StaticResource PropertyView.LabelBorderStyle}" Margin="0,8,0,4">
          <TextBlock Text="{x:Static resources:ProjectLauncher.OutputPath}" Style="{StaticResource PropertyView.LabelTextStyle}" />
        </Border>
        <DockPanel Margin="0,0,0,12">
          <Button x:Name="OutputDirectoryButton" DockPanel.Dock="Right" Margin="6,0,0,0" Width="36"
                  ToolTip="{x:Static resources:ProjectLauncher.OutputDirectory}">
            <icons:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource FlowBlox.ToolbarIconBase}" />
          </Button>
          <TextBox x:Name="OutputPath" IsReadOnly="True" Style="{StaticResource PropertyView.TextEditorStyle}" />
        </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Button Click="OpenArtifacts_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <icons:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" Foreground="#BD9550" Margin="0,0,6,0" />
                  <TextBlock Text="{x:Static resources:ProjectLauncher.Artifacts}" />
                </StackPanel>
              </Button>
              <Button x:Name="ResetArtifactsButton" Click="ResetArtifacts_Click">
                <StackPanel Orientation="Horizontal">
                  <icons:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="#BD4E48" Margin="0,0,6,0" />
                  <TextBlock Text="{x:Static resources:ProjectLauncher.ResetArtifacts}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <views:ProjectOutputsView x:Name="OutputsView" />
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</mah:MetroWindow>
