<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    x:Class="FlowBlox.UICore.Views.ProjectExecutionWindow"
    Title="{x:Static resources:ProjectLauncher.Title}"
    Style="{DynamicResource FlowBlox.Window}"
    Width="760" Height="740" MinWidth="540" MinHeight="420"
    WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
        <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/PropertyViewStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="10">
    <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogHeader}">
      <TextBlock x:Name="ProjectTitle" Style="{DynamicResource FlowBlox.DialogHeaderTitle}" />
    </Border>
    <Border DockPanel.Dock="Top" Style="{DynamicResource FlowBlox.DialogDescription}">
      <TextBlock x:Name="ProjectDescription" Style="{DynamicResource FlowBlox.DialogDescriptionText}" />
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <ProgressBar x:Name="RunningIndicator" IsIndeterminate="True" Height="4" Foreground="#2BA6B8" Background="#202BA6B8" Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,7" />
      <Border x:Name="CompletionBox" CornerRadius="8" BorderThickness="1" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="CompletionTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="CompletionMessage" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock x:Name="LogLinkContainer" Margin="0,8,0,0" Visibility="Collapsed">
            <Hyperlink x:Name="LogLink" Click="OpenLog_Click">
              <Run Text="{x:Static resources:ProjectLauncher.OpenLog}" />
            </Hyperlink>
          </TextBlock>
          <TextBlock x:Name="LogUnavailableText" Text="{x:Static resources:ProjectLauncher.LogUnavailable}"
                     TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray5}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <DockPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static resources:ProjectLauncher.Close}" IsCancel="True"
                    Style="{StaticResource FlowBlox.WindowActionButton.Back}" Click="Close_Click" />
            <Button x:Name="ExecuteButton" Style="{StaticResource FlowBlox.WindowActionButton}"
                    IsDefault="True" IsEnabled="False" Click="Execute_Click">
              <StackPanel Orientation="Horizontal">
                <icons:PackIconMaterial Kind="Play" Style="{StaticResource FlowBlox.WindowActionIcon.Apply}" />
                <AccessText Text="{x:Static resources:ProjectLauncher.Execute}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource PropertyView.LabelBorderStyle}" Margin="0,8,0,4">
          <TextBlock Text="{x:Static resources:ProjectLauncher.InputPath}" Style="{StaticResource PropertyView.LabelTextStyle}" />
        </Border>
        <DockPanel>
          <Button x:Name="InputDirectoryButton" DockPanel.Dock="Right" Margin="6,0,0,0" Width="36"
                  ToolTip="{x:Static resources:ProjectLauncher.InputDirectory}">
            <icons:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource FlowBlox.ToolbarIconBase}" />
          </Button>
          <TextBox x:Name="InputPath" IsReadOnly="True" Style="{StaticResource PropertyView.TextEditorStyle}" />
        </DockPanel>
        <Border Style="{StaticResource PropertyView.LabelBorderStyle}" Margin="0,8,0,4">
          <TextBlock Text="{x:Static resources:ProjectLauncher.OutputPath}" Style="{StaticResource PropertyView.LabelTextStyle}" />
        </Border>
        <DockPanel Margin="0,0,0,12">
          <Button x:Name="OutputDirectoryButton" DockPanel.Dock="Right" Margin="6,0,0,0" Width="36"
                  ToolTip="{x:Static resources:ProjectLauncher.OutputDirectory}">
            <icons:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource FlowBlox.ToolbarIconBase}" />
          </Button>
          <TextBox x:Name="OutputPath" IsReadOnly="True" Style="{StaticResource PropertyView.TextEditorStyle}" />
        </DockPanel>
        <StackPanel x:Name="Configuration">
        <Border Style="{StaticResource PropertyView.LabelBorderStyle}">
          <TextBlock Text="{x:Static resources:ProjectLauncher.Parameters}" Style="{StaticResource PropertyView.LabelTextStyle}" />
        </Border>
        <StackPanel x:Name="FieldsPanel" Margin="0,6,0,12" />
        <Border Style="{StaticResource PropertyView.LabelBorderStyle}">
          <TextBlock Text="{x:Static resources:ProjectLauncher.OptionOverrides}" Style="{StaticResource PropertyView.LabelTextStyle}" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,6">
          <Button x:Name="AddOptionButton" ToolTip="{x:Static resources:ProjectLauncher.AddOption}" Click="AddOption_Click" Padding="6,3">
            <icons:PackIconMaterial Kind="Plus" Style="{StaticResource FlowBlox.WindowActionIcon.Apply}" Margin="0" />
          </Button>
          <Button x:Name="RemoveOptionButton" ToolTip="{x:Static resources:ProjectLauncher.RemoveOption}" Click="RemoveOption_Click" Padding="6,3" IsEnabled="False">
            <icons:PackIconMaterial Kind="Delete" Style="{StaticResource FlowBlox.WindowActionIcon.Delete}" Margin="0" />
          </Button>
        </StackPanel>
        <DataGrid x:Name="OptionsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  MinHeight="100" MaxHeight="240" SelectionChanged="OptionsGrid_SelectionChanged"
                  ToolTip="{x:Static resources:ProjectLauncher.OptionTooltip}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{x:Static resources:ProjectLauncher.Option}" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding AvailableOptionKeys}" SelectedItem="{Binding OptionKey, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding OptionKey}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static resources:ProjectLauncher.Value}" Width="*"
                                Binding="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
          </DataGrid.Columns>
        </DataGrid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</mah:MetroWindow>
