<UserControl x:Class="FlowBlox.UICore.Views.AiAssistantDebugSelectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources">
    <StackPanel Margin="0,0,0,10">
        <Border CornerRadius="6" Background="#FFF0F4F8" Padding="10,8" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <icons:PackIconMaterial Kind="ViewGridOutline" Width="14" Height="14" Foreground="#FF52708B" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Static resources:AiAssistantDebugView.AllEntries}" FontSize="11" FontWeight="SemiBold" Foreground="#FF52616E" />
                    <TextBlock Text="{Binding Statistics}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border CornerRadius="6" Background="#FFEAF2FC" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <icons:PackIconMaterial Kind="CheckboxMultipleMarkedOutline" Width="14" Height="14" Foreground="#FF2F6DB3" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Static resources:AiAssistantDebugView.Selection}" FontSize="11" FontWeight="SemiBold" Foreground="#FF2F6DB3" />
                    <TextBlock Text="{Binding SelectionStatistics}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
