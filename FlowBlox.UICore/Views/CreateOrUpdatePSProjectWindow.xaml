<mah:MetroWindow Style="{DynamicResource FlowBlox.Window}"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="FlowBlox.UICore.Views.CreateOrUpdatePSProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:FlowBlox.UICore.Resources"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:views="clr-namespace:FlowBlox.UICore.Views"
    xmlns:converters="clr-namespace:FlowBlox.UICore.Converters"
    Title="{x:Static resources:CreateOrUpdatePSProjectWindow.Title}"
    Height="570"
    Width="760"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/MahAppMetroResources.xaml" />
                <ResourceDictionary Source="/FlowBlox.UICore;component/Views/Styles/FlowBloxCustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style x:Key="ProjectModeHeader" TargetType="Border">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.DropDownHoverBackground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FlowBlox.Brush.TabSelected}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource FlowBlox.Brush.DropDownFocusBorder}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ProjectModeHeaderText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.MutedText}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource FlowBlox.Brush.DropDownDisabledText}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <DockPanel Margin="10">

        <!-- Header -->
        <Border Style="{DynamicResource FlowBlox.DialogHeader}" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="CloudUploadOutline"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource FlowBlox.Brush.DialogHeaderText}"/>
                <TextBlock Style="{DynamicResource FlowBlox.DialogHeaderTitle}" Text="{x:Static resources:CreateOrUpdatePSProjectWindow.Header_Title}" />
            </StackPanel>
        </Border>

        <!-- Description -->
        <Border Style="{DynamicResource FlowBlox.DialogDescription}"
                DockPanel.Dock="Top"
                Margin="0,0,0,8">
            <TextBlock Style="{DynamicResource FlowBlox.DialogDescriptionText}" Text="{x:Static resources:CreateOrUpdatePSProjectWindow.Header_Description}" />
        </Border>

        <!-- Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main (scrollable) -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <Grid>
                    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                        <!-- Create new -->
                        <TabItem Header="{x:Static resources:CreateOrUpdatePSProjectWindow.Tab_CreateNewProject}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProjectModeHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PlusBoxOutline"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource ProjectModeHeaderText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Padding="0,5"/>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <TabItem.ToolTip>
                                <ToolTip Content="{x:Static resources:CreateOrUpdatePSProjectWindow.Tooltip_Tab_CreateNewProject}" />
                            </TabItem.ToolTip>

                            <views:ProjectSpaceProjectFormControl />
                        </TabItem>

                        <!-- Update existing -->
                        <TabItem Header="{x:Static resources:CreateOrUpdatePSProjectWindow.Tab_UpdateExistingProject}"
                                 Visibility="{Binding ShowUpdateTab, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsEnabled="{Binding CanSelectUpdateTab}">
                            <TabItem.HeaderTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProjectModeHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CloudUploadOutline"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="#3A6EA5"/>
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource ProjectModeHeaderText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Padding="0,5"/>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </TabItem.HeaderTemplate>

                            <TabItem.ToolTip>
                                <ToolTip Content="{x:Static resources:CreateOrUpdatePSProjectWindow.Tooltip_Tab_UpdateExistingProject}" />
                            </TabItem.ToolTip>

                            <views:ProjectSpaceProjectFormControl />
                        </TabItem>

                    </TabControl>
                </Grid>
            </ScrollViewer>

            <!-- Error message (always visible) -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock x:Name="MissingProjectHintText" Text="{Binding MissingProjectHint}"
                           Foreground="DarkGoldenrod"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorText}"
                           Foreground="Red"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Footer buttons (always visible) -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{x:Static resources:CreateOrUpdatePSProjectWindow.Button_Back}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Back}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"/>
                <Button Content="{x:Static resources:CreateOrUpdatePSProjectWindow.Button_Save}"
                        Style="{StaticResource FlowBlox.WindowActionButton.Save}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
        </DockPanel>

        <Border Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    Margin="20"
                    Padding="20">
                <StackPanel>
                <mah:ProgressRing IsActive="True"
                                  Width="40"
                                  Height="40"
                                  HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static resources:CreateOrUpdatePSProjectWindow.Loading_SaveInProgress}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</mah:MetroWindow>
