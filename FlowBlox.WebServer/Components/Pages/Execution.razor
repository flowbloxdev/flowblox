@page "/executions/{Id:guid}"
@attribute [Authorize]
@inherits DashboardPageBase
@inject DashboardService Dashboard
<PageTitle>@T["Execution"] · FlowBlox</PageTitle>
<a class="back" href="/executions">← @T["Executions"]</a>
@if (_entry != null)
{
    <h1>@_entry.Project.Name</h1>
    <p class="description">@_entry.ProjectDescription</p>
    <div class="notice info"><strong>@T["Started"] <time datetime="@_entry.StartedUtc.ToString("O")">@_entry.StartedUtc.ToString("u")</time> · PID @_entry.ProcessId</strong><p>@T["ReadOnly"]</p></div>
    <section class="panel"><div class="heading"><ExecutionStatus Entry="_entry" /><h2>@T[_entry.IsRunning ? "Running" : _entry.Response?.Success == true ? "Succeeded" : "Failed"]</h2></div>
        @if (_entry.IsRunning) { <div class="loading-line"></div> }
        else
        {
            <p class="prewrap">@(_entry.LaunchError + (_entry.Response?.ErrorMessage ?? string.Empty) + (_entry.Response?.AbortMessage ?? string.Empty))</p>
            @if (!string.IsNullOrEmpty(_entry.Response?.LogfilePath)) { <a class="button" href="@($"/logs/{Id}")">@T["RuntimeLog"] ↓</a> }
            else { <p class="muted">@T["NoLog"]</p> }
        }
    </section>
    @if (_error) { <p class="notice error">@T["OperationFailed"]</p> }
    <footer class="actions">
        @if (_projectId != null) { <a class="button" href="@($"/projects/{_projectId}/artifacts?executionId={Id}")">@T["Artifacts"] <span class="badge">@_artifactCount</span></a> }
        @if (Dashboard.Executions.CanTerminate(_entry))
        {
            @if (!_confirmStop) { <button class="danger" @onclick="() => _confirmStop = true"><MdiIcon Name="stop" /> @T["StopProcess"]</button> }
            else { <span>@T["ConfirmStop"]</span><button @onclick="StopAsync">@T["Confirm"]</button><button @onclick="() => _confirmStop = false">@T["Cancel"]</button> }
        }
    </footer>
}
@code {
    [Parameter] public Guid Id { get; set; }
    private ProjectExecutionEntry? _entry;
    private string? _projectId;
    private int _artifactCount;
    private bool _confirmStop, _error;
    protected override async Task OnInitializedAsync() { if (Dashboard.Projects.Count == 0) await Dashboard.RefreshProjectsAsync(); await RefreshAsync(); BeginRefreshing(RefreshAsync); }
    private async Task RefreshAsync()
    {
        _entry = Dashboard.GetExecution(Id);
        _projectId = Dashboard.Projects.FirstOrDefault(project => ProjectShortcutIdentity.Matches(project.Shortcut, _entry.Project))?.Id;
        if (_projectId != null) { try { _artifactCount = (await Dashboard.ArtifactsAsync(_projectId, Id)).Count(); } catch { _artifactCount = 0; } }
    }
    private async Task StopAsync() { if (!await HasSessionAsync()) return; try { Dashboard.Executions.Terminate(Id); _confirmStop = false; } catch { _error = true; } }
}
