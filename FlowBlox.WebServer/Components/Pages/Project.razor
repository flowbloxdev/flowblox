@page "/projects/{Id}"
@attribute [Authorize]
@inherits DashboardPageBase
@inject DashboardService Dashboard
@inject NavigationManager Navigation
@inject ILogger<Project> Logger
<PageTitle>@(_project?.Shortcut.Name) · FlowBlox</PageTitle>
@if (_error) { <p role="alert" class="notice error">@T["OperationFailed"]</p> }
@if (_form == null)
{
    @if (!_error) { <div class="loading-line" role="status" aria-label="@T["Loading"]"></div> }
    else { <button @onclick="RetryAsync">@T["Retry"]</button> }
}
else
{
    <a class="back" href="/">← @T["Projects"]</a>
    <div class="heading"><h1>@_project!.Shortcut.Name</h1></div>
    <p class="description">@_form.Description</p>
    @if (!string.IsNullOrWhiteSpace(_form.Notice)) { <details class="notes"><summary>☀ @T["ProjectNotes"]</summary><ProjectNoticeMarkdown Text="@_form.Notice" /></details> }
    <nav class="execution-tabs" aria-label="@T["Project"]">
        <button class="@(!_showOutputs ? "active" : null)" aria-pressed="@(!_showOutputs)" @onclick="() => _showOutputs = false"><MdiIcon Name="form-textbox" /> @T["Inputs"]</button>
        <button class="@(_showOutputs ? "active" : null)" aria-pressed="@_showOutputs" @onclick="() => _showOutputs = true"><MdiIcon Name="file-export" /> @T["Outputs"]</button>
    </nav>
    @if (_showOutputs)
    {
        <OutputArtifacts ProjectId="@Id" OutputDirectory="@_form.OutputDirectory" />
        <section class="panel"><p class="empty">@T["NoResults"]</p></section>
    }
    <div hidden="@_showOutputs">
    <section class="panel directories"><label>@T["InputDirectory"]<input value="@_form.InputDirectory" readonly /></label></section>
    <h2>@T["InputParameters"]</h2>
    <InputConfigurations ProjectId="@Id" Form="_form" Disabled="_busy" Applied="ConfigurationApplied" />
    <div class="input-layout">
        <section class="panel inputs">
            @if (_form.Fields.Count == 0) { <p class="empty">ⓘ @T["NoInputs"]</p> }
            else
            {
                <div class="toolbar"><button class="quiet" disabled="@_busy" @onclick="ClearAsync"><MdiIcon Name="backup-restore" /> @T["Clear"]</button></div>
                @foreach (var field in _form.Fields)
                {
                    <InputFieldEditor @key="field.Name" Field="field" ProjectGuid="_form.ProjectGuid" Disabled="_busy" OutputDirectories="_outputDirectories" References="_form.FieldReferences" @bind-Value="_form.Values[field.Name]" />
                }
            }
            <details class="overrides"><summary>@T["OptionOverrides"] <span class="badge">@_form.Overrides.Count</span></summary>
                @foreach (var key in _form.Overrides.Keys.ToList())
                { <div class="override-row"><label>@key<input disabled="@_busy" @bind="_form.Overrides[key]" /></label><button disabled="@_busy" title="@T["Remove"]" @onclick="() => _form.Overrides.Remove(key)">×</button></div> }
                @if (_form.Overrides.Count == 0) { <p class="empty">ⓘ @T["NoOverrides"]</p> }
                <div class="override-row"><select aria-label="@T["OptionOverrides"]" @bind="_optionKey"><option value="">@T["SelectOption"]</option>@foreach (var option in Dashboard.AvailableOptions) { <option value="@option.Name">@option.Name</option> }</select><button disabled="@(_busy || string.IsNullOrEmpty(_optionKey))" @onclick="AddOverride">＋ @T["Add"]</button></div>
            </details>
        </section>
    </div>
    </div>
    <footer class="actions"><a href="/" class="button">← @T["Back"]</a><button class="primary" disabled="@(_busy || !CanRun)" @onclick="StartAsync"><MdiIcon Name="play" /> @T["RunProject"]</button></footer>
}
@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private WebProject? _project;
    private ProjectForm? _form;
    private IReadOnlyList<ProjectOutputDirectoryChoice> _outputDirectories = [];
    private bool _busy, _error, _showOutputs;
    private string _optionKey = string.Empty;
    private bool CanRun => _form != null && _form.Fields.All(input => !input.IsRequiredAtRuntimeStartup || !string.IsNullOrWhiteSpace(_form.Values.GetValueOrDefault(input.Name)));
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (Dashboard.Projects.Count == 0) await Dashboard.RefreshProjectsAsync();
            _project = Dashboard.GetProject(Id);
            _form = await Dashboard.LoadFormAsync(Id);
            _outputDirectories = ProjectOutputDirectoryChoice.Create(Dashboard.Projects.Select(project => project.Shortcut.Name));
        }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not load the web project editor."); _error = true; }
    }
    private void ConfigurationApplied() => StateHasChanged();
    private async Task RetryAsync()
    {
        if (!await HasSessionAsync()) return;
        await OnParametersSetAsync();
    }
    private async Task ClearAsync()
    {
        if (!await HasSessionAsync()) return;
        try { _form = await Dashboard.LoadFormAsync(Id); _error = false; }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not reset web project inputs."); _error = true; }
    }
    private void AddOverride() { if (!string.IsNullOrEmpty(_optionKey)) _form!.Overrides.TryAdd(_optionKey, string.Empty); _optionKey = string.Empty; }
    private async Task StartAsync()
    {
        if (!await HasSessionAsync()) return;
        _busy = true; _error = false;
        try { var entry = await Dashboard.StartAsync(Id, _form!); Navigation.NavigateTo($"/executions/{entry.Id}"); }
        catch (Exception exception) { Logger.LogWarning(exception, "Could not start project from web dashboard."); _error = true; }
        finally { _busy = false; }
    }
}
