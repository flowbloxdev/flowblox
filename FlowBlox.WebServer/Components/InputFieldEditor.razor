@using FlowBlox.Core.Models.Components
@using FlowBlox.Core.Attributes
@using FlowBlox.Core.Enums
@using FlowBlox.Core.Util.Resources
@using FlowBlox.Core.Util.Fields
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@implements IAsyncDisposable
<div class="field-editor" id="@(_id + "-editor")" data-field-name="@Field.Name">
    <div class="field-heading"><label for="@_id">
        <span class="field-title-text">@DisplayName</span>
        @if (Required)
        {
            <span class="field-required" role="img" aria-label="@RequiredText" title="@RequiredText"><MdiIcon Name="star" /></span>
        }
    </label>
        <span class="field-value-status @FieldValuePresentation.GetStateName(Value, Required)" title="@StatusText" aria-hidden="true"><MdiIcon Name="circle" /></span>
    </div>
    <div class="field-value-row">
    <div class="field-value-control">
    @if (Field.GetValueDropDownMode() == DropDownMode.SelectionOnly && !Field.IsPassword)
    {
        <select id="@_id" aria-required="@Required.ToString().ToLowerInvariant()" aria-describedby="@(_id + "-status")" disabled="@Disabled" value="@Value" @onchange="ChangeAsync"><option value=""></option>
            @foreach (var item in Field.GetPossibleValues()) { <option value="@item.Value">@item.ToString()</option> }
        </select>
    }
    else if (Field.IsPassword)
    { <PasswordInput Id="@_id" Label="@DisplayName" Required="@Required" DescribedBy="@(_id + "-status")" Disabled="Disabled" Value="@Value" ValueChanged="ValueChanged" /> }
    else
    {
        @if (Field.DisplayMode == FieldDisplayMode.List)
        {
            <div class="field-list" role="group" aria-label="@DisplayName">
                @foreach (var entry in _entries)
                {
                    var entryId = EntryId(entry);
                    <div class="field-list-row" @key="entry.Id">
                        <textarea id="@entryId" rows="@(HasLineBreak(entry.Value) ? 3 : 1)" class="field-list-value"
                                  aria-label="@T["InputListItem", _entries.IndexOf(entry) + 1]" disabled="@Disabled"
                                  @bind:get="entry.Value" @bind:set="value => ChangeEntryAsync(entry, value)" @bind:event="oninput"></textarea>
                        <button type="button" class="quiet small-action icon-button" aria-label="@T["InputRemoveItem", _entries.IndexOf(entry) + 1]"
                                title="@T["Remove"]" disabled="@Disabled" @onclick="() => RemoveEntryAsync(entry)"><MdiIcon Name="delete" /></button>
                    </div>
                }
                <button type="button" class="quiet small-action field-list-add" disabled="@Disabled" @onclick="AddEntryAsync">+ @T["InputAddItem"]</button>
            </div>
        }
        else if (IsMultiline)
        {
            <textarea id="@_id" aria-required="@Required.ToString().ToLowerInvariant()" aria-describedby="@(_id + "-status")"
                      disabled="@Disabled" rows="5" @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput"></textarea>
        }
        else
        {
            <input id="@_id" type="text"
                   aria-required="@Required.ToString().ToLowerInvariant()" aria-describedby="@(_id + "-status")" disabled="@Disabled"
                   @bind:get="Value" @bind:set="SetValueAsync" @bind:event="oninput" />
        }
        @if (Field.GetPossibleValues().Any())
        {
            <details class="suggestions"><summary>@T["Suggestions"]</summary><div class="suggestion-values">
                @foreach (var item in Field.GetPossibleValues())
                { <button type="button" disabled="@Disabled" @onclick="() => ValueChanged.InvokeAsync(item.Value)">@item.ToString()</button> }
            </div></details>
        }
    }
    </div>
    @if (Field.GetValueDropDownMode() != DropDownMode.SelectionOnly)
    {
        <details class="field-insert-picker" data-insert-picker>
            <summary class="quiet small-action" aria-label="@T["InputInsert"]" title="@T["InputInsert"]"
                     aria-disabled="@Disabled.ToString().ToLowerInvariant()" tabindex="@(Disabled ? -1 : 0)">
                <MdiIcon Name="content-paste" /><span class="field-insert-caption">@T["InputInsert"]</span><span aria-hidden="true">&#9662;</span>
            </summary>
            <div class="field-insert-options">
                <div data-insert-panel="main">
                    @if (References.Count > 0)
                    {
                        <button type="button" disabled="@Disabled" data-insert-view="fields">(x) <span>@T["InputChooseField"]</span></button>
                    }
                    @if (Field.LoVType != LoVType.PossibleValues && OutputDirectories.Count > 0)
                    {
                        <button type="button" disabled="@Disabled" data-insert-view="outputs"><MdiIcon Name="folder-upload-outline" /><span>@T["InputChooseProjectOutput"]</span></button>
                    }
                    @if (_clipboard)
                    {
                        <button type="button" disabled="@Disabled" data-paste-target="@ReferenceTargetId"><MdiIcon Name="content-paste" /><span>@T["InputPasteClipboard"]</span></button>
                    }
                    else
                    {
                        <small>@T["PasteUnavailable"]</small>
                    }
                </div>
                <div data-insert-panel="fields" hidden>
                    <button type="button" class="field-insert-back" data-insert-view="main">&#8592; @T["Back"]</button>
                    <strong>@T["InputChooseField"]</strong>
                    @foreach (var group in References.GroupBy(reference => reference.Group))
                    {
                        <small>@T[group.Key]</small>
                        @foreach (var reference in group)
                        {
                            <button type="button" disabled="@Disabled" data-field-target="@ReferenceTargetId" data-field-reference="@reference.Reference">@reference.Name</button>
                        }
                    }
                </div>
                <div data-insert-panel="outputs" hidden>
                    <button type="button" class="field-insert-back" data-insert-view="main">&#8592; @T["Back"]</button>
                    <strong>@T["InputChooseProjectOutput"]</strong>
                    @foreach (var choice in OutputDirectories)
                    {
                        <button type="button" disabled="@Disabled" data-field-target="@ReferenceTargetId" data-field-reference="@choice.Value">@choice.DisplayName</button>
                    }
                </div>
            </div>
        </details>
    }
    <span id="@(_id + "-status")" class="visually-hidden">@StatusText</span>
    </div>
    <small role="status" data-paste-error hidden>@T["PasteUnavailable"]</small>
</div>
@code {
    [Parameter, EditorRequired] public FieldElement Field { get; set; } = default!;
    [Parameter] public Guid ProjectGuid { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IReadOnlyList<ProjectOutputDirectoryChoice> OutputDirectories { get; set; } = [];
    [Parameter] public IReadOnlyList<FieldReferenceOption> References { get; set; } = [];
    private bool Required => Field.IsUserInputField() && Field.IsRequiredAtRuntimeStartup;
    private string RequiredText => FlowBloxResourceUtil.GetLocalizedString("FieldElement_RequiredInput", typeof(FlowBlox.Core.FlowBloxTexts));
    private string StatusText => FieldValuePresentation.GetDescription(Value, Required);
    private string DisplayName => InputFieldPresentation.GetDisplayName(Field.Name);
    private bool CanUseList => !Field.IsPassword && Field.GetValueDropDownMode() != DropDownMode.SelectionOnly;
    private bool IsMultiline => Field.DisplayMode == FieldDisplayMode.Multiline;
    private string Separator => FieldListPresentation.ResolveSeparator(Field.ListSeparator);
    private string ReferenceTargetId => Field.DisplayMode == FieldDisplayMode.List ? _activeEntryId ?? _id : _id;
    private bool _clipboard, _focusInput;
    private readonly string _id = "field-" + Guid.NewGuid().ToString("N");
    private readonly List<InputListEntry> _entries = [];
    private string _scope = string.Empty;
    private string _listSource = string.Empty;
    private string? _activeEntryId;
    private DotNetObjectReference<InputFieldEditor>? _receiver;

    protected override void OnParametersSet()
    {
        var scope = ProjectGuid.ToString("D") + ":" + Field.Name;
        if (_scope != scope)
        {
            _scope = scope;
            _entries.Clear();
            _activeEntryId = null;
        }
        if (Field.DisplayMode == FieldDisplayMode.List && (_entries.Count == 0 || _listSource != Value))
            ReadList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _receiver = DotNetObjectReference.Create(this);
                await JavaScript.InvokeVoidAsync("FlowBloxFieldEditors.attach", _id + "-editor", _receiver);
                _clipboard = await JavaScript.InvokeAsync<bool>("flowBloxClipboardAvailable");
                StateHasChanged();
            }
            if (_focusInput)
            {
                _focusInput = false;
                await JavaScript.InvokeVoidAsync("FlowBloxFieldEditors.focus", ReferenceTargetId);
            }
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private static bool HasLineBreak(string value) => value.Contains('\r') || value.Contains('\n');
    private string EntryId(InputListEntry entry) => ReferenceEquals(entry, _entries.FirstOrDefault()) ? _id : _id + "-" + entry.Id;

    private void ReadList()
    {
        _entries.Clear();
        foreach (var item in FieldListPresentation.Split(Value, Field.ListSeparator))
            _entries.Add(new InputListEntry { Value = item });
        _listSource = Value;
        _activeEntryId = null;
    }

    private async Task ChangeEntryAsync(InputListEntry entry, string value)
    {
        if (Disabled)
            return;

        var index = _entries.IndexOf(entry);
        var values = _entries.Select(item => item.Value).ToList();
        FieldListPresentation.Apply(values, index, value, Field.ListSeparator);
        for (var row = index; row < values.Count; row++)
        {
            if (row < _entries.Count)
                _entries[row].Value = values[row];
            else
                _entries.Add(new InputListEntry { Value = values[row] });
        }

        await PublishListAsync();
    }

    private async Task AddEntryAsync()
    {
        if (Disabled)
            return;
        var entry = new InputListEntry();
        _entries.Add(entry);
        _activeEntryId = EntryId(entry);
        _focusInput = true;
        await PublishListAsync();
    }

    private async Task RemoveEntryAsync(InputListEntry entry)
    {
        if (Disabled)
            return;
        _entries.Remove(entry);
        if (_entries.Count == 0)
            _entries.Add(new InputListEntry());
        _activeEntryId = null;
        await PublishListAsync();
    }

    private Task PublishListAsync()
    {
        _listSource = string.Join(Separator, _entries.Select(entry => entry.Value));
        return ValueChanged.InvokeAsync(_listSource);
    }

    [JSInvokable]
    public async Task ReceiveTextAsync(string inputId, string value)
    {
        if (Disabled)
            return;
        if (Field.DisplayMode == FieldDisplayMode.List && CanUseList)
        {
            var entry = _entries.FirstOrDefault(item => EntryId(item) == inputId);
            if (entry != null)
                await ChangeEntryAsync(entry, value);
        }
        else
        {
            await ValueChanged.InvokeAsync(value);
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_receiver == null)
            return;
        try { await JavaScript.InvokeVoidAsync("FlowBloxFieldEditors.detach", _id + "-editor"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        finally { _receiver.Dispose(); }
    }

    private Task ChangeAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task SetValueAsync(string value) => ValueChanged.InvokeAsync(value);
}
