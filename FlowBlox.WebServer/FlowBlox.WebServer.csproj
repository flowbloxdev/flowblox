<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>..\FlowBlox.WorkerService\FlowBloxMainIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <ProjectReference Include="..\FlowBlox.Core\FlowBlox.Core.csproj" />
    <ProjectReference Include="..\FlowBlox.RunnerHost\FlowBlox.RunnerHost.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained">
      <Private Condition="'$(PublishRunnerHost)' == 'false'">false</Private>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyRunnerHost" AfterTargets="Build" Condition="'$(PublishRunnerHost)' != 'false'">
    <ItemGroup><RunnerFiles Include="..\FlowBlox.RunnerHost\bin\$(Configuration)\$(TargetFramework)\FlowBlox.RunnerHost.*" /></ItemGroup>
    <Copy SourceFiles="@(RunnerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="PublishRunnerCompanion" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="CopyRunnerHost" Condition="'$(PublishRunnerHost)' != 'false'">
    <ItemGroup>
      <ResolvedFileToPublish Include="..\FlowBlox.RunnerHost\bin\$(Configuration)\$(TargetFramework)\FlowBlox.RunnerHost.dll">
        <RelativePath>FlowBlox.RunnerHost.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
