  "ProjectGuid": "ab14dbb9-b4e6-4520-9632-bdb952174c6f",
  "ProjectName": "Jira Data Center - JQL to XLSX",
  "Author": "FlowBlox",
  "ProjectDescription": "This project exports tickets from a locally hosted Jira Data Center instance to an Excel workbook. It authenticates with username and password, selects tickets using a configurable JQL query, and exports ticket details including sprint, assignee, story points, and description.",
  "AssistantMetadata": {
    "$id": "92",
    "$type": "FlowBlox.Core.Models.Project.AssistantMetadata, FlowBlox.Core",
    "ShortDescription": "Export Jira Data Center tickets selected by JQL to XLSX using REST API v2, Basic Auth and complete pagination."
  },
  "Notice": "Uses the public Atlassian Jira Data Center OpenAPI definition. REST API version 2 is separate from the OpenAPI specification format v3. Use HTTPS outside loopback. Basic Auth must be enabled; SSO/CAPTCHA may prevent password authentication. No Jira data is modified.",
  "GridSizeX": 3428,
  "GridSizeY": 1650,
  "AutoIncreaseGridSize": true,
