      {
        "$id": "12",
        "$type": "FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core",
        "Name": "JqlFilter",
        "FieldType": {
          "$id": "13",
          "$type": "FlowBlox.Core.Models.Components.TypeElement, FlowBlox.Core",
