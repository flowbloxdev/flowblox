          "IsNullable": true
        },
        "UserField": true,
        "UserFieldType": "Input",
        "StringValue": "issuetype in (Bug, Task, Story) AND sprint in openSprints()",
        "StoreValueLocally": false,
        "ClearOnRuntimeStart": false,
        "IsRequiredAtRuntimeStartup": true,
        "IsPassword": false,
        "SyntaxHighlighting": "JQL",
        "LoVType": "Suggestion",
        "ListOfValues": {
          "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core]], System.ObjectModel",
          "$values": [
            {
              "$id": "14",
              "$type": "FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core",
              "DisplayName": "Bug, Task and Story in active sprints (default)",
              "Value": "issuetype in (Bug, Task, Story) AND sprint in openSprints()"
            },
            {
              "$id": "15",
              "$type": "FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core",
              "DisplayName": "Named sprint 1.2500.0.0",
              "Value": "issuetype in (Bug, Task, Story) AND sprint = \"1.2500.0.0\""
            },
            {
              "$id": "16",
              "$type": "FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core",
              "DisplayName": "Unresolved bugs",
              "Value": "issuetype = Bug AND statusCategory != Done"
            },
            {
              "$id": "17",
              "$type": "FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core",
              "DisplayName": "Bug, Task and Story without a sprint restriction",
              "Value": "issuetype in (Bug, Task, Story)"
            }
          ]
        },
        "Source": null,
