      {
        "$id": "88",
        "$type": "FlowBlox.Core.Models.FlowBlocks.NoteFlowBlock, FlowBlox.Core",
        "Note": "2. JQL / input editor\nJqlFilter uses AvalonEdit with JQL syntax highlighting and has editable suggestions. The language is configurable in the field General tab; the default for other fields is Text. Default: Bug, Task and Story in openSprints(). Select the named-sprint example for sprint = \"1.2500.0.0\", or enter another filter clause without ORDER BY. The REST block adds the ProjectKey scope and ORDER BY key ASC for deterministic pagination.",
        "OverriddenNotificationEntries": {
          "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.FlowBlocks.Base.OverriddenNotificationEntry, FlowBlox.Core]], System.ObjectModel",
          "$values": []
        },
