      {
        "$id": "91",
        "$type": "FlowBlox.Core.Models.FlowBlocks.NoteFlowBlock, FlowBlox.Core",
        "Note": "5. XLSX output\nJSON_TicketRows uses a common RowPath so missing assignees, estimates or descriptions do not shift columns. Sprint names are extracted from legacy Data Center strings or structured sprint objects. TableWriter accumulates the rows and writes one fresh XLSX at successful runtime finish, including headers when no tickets match. On aborted REST execution the previous file is kept. Output: $User::OutputFile.",
        "OverriddenNotificationEntries": {
          "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.FlowBlocks.Base.OverriddenNotificationEntry, FlowBlox.Core]], System.ObjectModel",
