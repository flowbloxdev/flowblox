        "ListOfValues": {
          "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core]], System.ObjectModel",
          "$values": [
            {
              "$id": "12",
              "$type": "FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core",
              "DisplayName": "Bugs, tasks and stories in active sprints",
              "Value": "project = DEMO AND issuetype in (Bug, Task, Story) AND sprint in openSprints() ORDER BY key ASC"
            },
            {
              "$id": "13",
              "$type": "FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core",
              "DisplayName": "Recently updated tickets",
              "Value": "project = DEMO AND updated >= -7d ORDER BY updated DESC"
            },
            {
              "$id": "14",
              "$type": "FlowBlox.Core.Models.Components.ValueItem, FlowBlox.Core",
              "DisplayName": "A named sprint",
              "Value": "project = DEMO AND sprint = \"1.2500.0.0\" ORDER BY key ASC"
            }
          ]
        },
        "Source": null,
