  "ProjectGuid": "83f92f1f-3f26-4669-89ca-0c355f0e1989",
  "ProjectName": "GetFileContent",
  "Author": null,
  "ProjectDescription": "Reads FilePath and returns FileContent as text. InputFileType must be Pdf, Xlsx, Docx or Text (default Text). Encoding defaults to UTF8 and applies only to Text. PDF and DOCX pages are joined with newlines. XLSX uses the first worksheet, treats its first row as column headers and returns CSV with comma separators. Binary documents are read as bytes and passed to the existing PDF/Open XML/table converters.",
  "AssistantMetadata": {
    "ShortDescription": "Read PDF, DOCX, XLSX or text files as text."
  },
