  "ProjectGuid": "5a7502a1-fca0-4cf2-9ecf-60059cd5cca7",
  "ProjectName": "ListFiles",
  "Author": null,
  "ProjectDescription": "Returns all matching full file paths as newline-separated Files text. DirectoryPath is required; Recursive defaults to false. Optional FilterString supports semicolon-separated wildcard includes and !excludes (for example *.txt;!temp/*). Empty filters include all files.",
  "AssistantMetadata": {
    "ShortDescription": "List files in a directory, optionally recursively with wildcard filters."
  },
