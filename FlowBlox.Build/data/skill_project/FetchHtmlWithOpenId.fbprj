      ],
      "RequiredFields": [ { "$ref": "content" } ],
      "ResultField": {
        "$type": "FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core",
        "Name": "Success",
        "FieldType": { "FieldType": "Boolean" },
        "Source": { "$ref": "output" }
