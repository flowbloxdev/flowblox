      "Name": "Url",
      "FieldType": { "FieldType": "Text" },
      "UserField": true,
      "UserFieldType": "Input"
    }
  ],
  "FlowBlocks": [
    {
      "$id": "start",
      "$type": "FlowBlox.Core.Models.FlowBlocks.SequenceFlow.StartFlowBlock, FlowBlox.Core",
      "Name": "Start",
      "Location": "50, 400"
    },
    {
      "$id": "auth",
      "$type": "FlowBlox.Core.Models.FlowBlocks.Authorization.OAuthFlowBlock, FlowBlox.Core",
      "Name": "OAuth_PasswordGrant",
      "Location": "458, 400",
      "TokenEndpoint": "$User::TokenEndpoint",
      "ClientId": "$User::ClientId",
      "ClientSecret": "$User::ClientSecret",
      "Scope": "$User::Scope",
      "Audience": "$User::Audience",
      "GrantType": "Password",
      "SendClientCredentialsInBody": true,
      "UserName": "$User::UserName",
      "Password": "$User::Password",
      "ResultField": {
        "$id": "token",
        "$type": "FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core",
