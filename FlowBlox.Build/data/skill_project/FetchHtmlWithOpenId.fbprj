      "FieldType": { "FieldType": "Text" },
      "UserField": true,
      "UserFieldType": "Input"
    },
    {
      "$type": "FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core",
      "Name": "ClientSecret",
      "FieldType": { "FieldType": "Text" },
      "UserField": true,
      "UserFieldType": "Input",
      "IsPassword": true,
      "StoreValueLocally": true
    },
    {
      "$type": "FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core",
