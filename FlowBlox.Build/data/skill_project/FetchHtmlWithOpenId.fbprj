      "HTTPAction": "GET",
      "ResponseBodyKind": "Text",
      "WebRequestTimeout": 30000,
      "RequiredFields": [ { "$ref": "token" } ],
      "HeaderParameters": [
        { "Key": "Authorization", "Value": "Bearer $OAuth_PasswordGrant::AccessToken" },
        { "Key": "Accept", "Value": "text/html" }
      ],
      "ResultFields": [
        {
          "EnumValue": "Content",
          "ResultField": {
