{
  "$type": "FlowBlox.Core.Models.Project.FlowBloxProject, FlowBlox.Core",
  "ProjectGuid": "92a3de60-c855-40b4-a329-76383775ac14",
  "ProjectName": "FetchHtmlWithOpenId",
  "ProjectDescription": "Compact Skill Project providing the authenticated HTML retrieval Skill: obtain an OAuth/OpenID access token using the password grant, then GET Url with Authorization: Bearer and return the HTTP response text as Content. Inputs: TokenEndpoint, ClientId, ClientSecret, Scope (optional), Audience (optional), UserName, Password and Url. Client credentials are sent in the token request body. Pass Password and ClientSecret through protected main-project input-field references in inputParameters (for example $User::LoginPassword); never supply their secret values to the AI. Returns raw HTML without browser rendering or JavaScript execution; the page must support Bearer authentication. Access tokens and credentials are not declared outputs.",
  "AssistantMetadata": {
    "ShortDescription": "Fetch HTML with an OpenID password grant and Bearer-authenticated GET; returns Content."
  },
  "UserFields": [
    {
      "$type": "FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core",
      "Name": "TokenEndpoint",
      "FieldType": { "FieldType": "Text" },
