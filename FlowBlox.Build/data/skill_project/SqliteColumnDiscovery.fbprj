          "ColumnConditions": {
            "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.FlowBlocks.IO.TableSelectorColumnCondition, FlowBlox.Core]], System.ObjectModel",
            "$values": []
          },
          "ReferencedTable": {
            "$id": "34",
            "$type": "FlowBlox.Core.Models.Components.IO.SQLTable, FlowBlox.Core",
            "DbType": "SQLite",
            "SQLConnectionstring": "Data Source=$User::Input_SqliteDatabasePath;",
            "SQLStatement": "SELECT\n    p.name AS ColumnName,\n    p.type AS DataType,\n    p.type AS TypeSpecification,\n    CASE WHEN p.\"notnull\" = 0 THEN 'true' ELSE 'false' END AS IsNullable,\n    p.dflt_value AS DefaultValue,\n    CASE WHEN p.pk > 0 THEN 'true' ELSE 'false' END AS IsPrimaryKey,\n    CASE WHEN p.pk > 0 OR EXISTS (\n        SELECT 1\n        FROM pragma_index_list($User::Input_TableName) il\n        INNER JOIN pragma_index_info(il.name) ii ON ii.name = p.name\n        WHERE il.\"unique\" = 1\n    ) THEN 'true' ELSE 'false' END AS IsUnique,\n    CASE WHEN p.pk > 0\n        AND UPPER(p.type) = 'INTEGER'\n        AND (SELECT COUNT(*) FROM pragma_table_info($User::Input_TableName) key_column WHERE key_column.pk > 0) = 1\n        THEN 'true' ELSE 'false' END AS IsAutoIncrement,\n    p.cid + 1 AS OrdinalPosition\nFROM pragma_table_info($User::Input_TableName) p\nORDER BY p.cid",
            "UseFieldValuesAsParameters": true,
            "Name": "SQLTable_SqliteColumns",
            "RequiredFields": {
              "$type": "System.Collections.ObjectModel.ObservableCollection`1[[FlowBlox.Core.Models.Components.FieldElement, FlowBlox.Core]], System.ObjectModel",
              "$values": [
                {
                  "$ref": "2"
                },
                {
                  "$ref": "4"
                }
              ]
            },
            "Version": "1.0.0.0"
