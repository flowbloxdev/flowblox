<interop:DesktopWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="using:FlowBlox.AvaloniaDesktop.Interop"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="FlowBlox.AppWindow.AppWindow"
        Title="FlowBlox" Width="1420" Height="1000" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/App.ico">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Height="1" Background="#A0A0A0" />
    <Border x:Name="NotificationBar" DockPanel.Dock="Bottom" IsVisible="False"
            Background="#263B46" BorderBrush="#568FA5" BorderThickness="0,1,0,0" Padding="12,8">
      <DockPanel>
        <Button x:Name="NotificationAction" DockPanel.Dock="Right" Foreground="#D7F3FF"
                Background="#355769" BorderBrush="#568FA5" BorderThickness="1" Padding="12,5" />
        <TextBlock x:Name="NotificationIcon" DockPanel.Dock="Left" Text="&#x24D8;" Foreground="#8FC7DD" FontSize="18"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="NotificationMessage" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="#EDF5F8" FontWeight="SemiBold" Margin="0,0,12,0" />
      </DockPanel>
    </Border>
    <Grid>
      <Image x:Name="Welcome" Source="/Assets/Welcome.png" Stretch="None" />
      <ScrollViewer x:Name="Shortcuts" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Margin="16" VerticalAlignment="Top">
        <ItemsControl x:Name="ShortcutBoxes">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#D6383838" BorderBrush="#557F7F7F" BorderThickness="1"
                      CornerRadius="9" MinWidth="260" MaxWidth="320" Height="240" Margin="8" Padding="12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Title}" Foreground="#F3F3F3" FontSize="14" FontWeight="SemiBold" />
                    <Border Height="1" Background="#447F7F7F" Margin="0,9,0,5" />
                  </StackPanel>
                  <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,5" />
                        <Setter Property="Margin" Value="0,1,22,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      </Style>
                      <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#335F9EA0" />
                      </Style>
                      <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#445F9EA0" />
                      </Style>
                      <Style Selector="ListBoxItem StackPanel.shortcutActions">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                      </Style>
                      <Style Selector="ListBoxItem:pointerover StackPanel.shortcutActions, ListBoxItem:selected StackPanel.shortcutActions">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="IsHitTestVisible" Value="True" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Detail}">
                          <StackPanel Orientation="Horizontal" Width="{Binding IconWidth}" Spacing="4" Margin="0,0,8,0"
                                      VerticalAlignment="Center">
                            <Image Source="{Binding ProjectIcon}" Width="16" Height="16" IsVisible="{Binding ShowLocalIcon}" />
                            <Image Source="/Assets/project-space-16.png" Width="16" Height="16" IsVisible="{Binding ShowOnlineIcon}" />
                            <Image Source="{Binding ExecutionIcon}" Width="16" Height="16" IsVisible="{Binding IsExecution}" />
                          </StackPanel>
                          <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Classes="shortcutName" Text="{Binding Name}" Foreground="#ECECEC" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="1" Width="14" MinWidth="0" MaxWidth="14"
                                         Height="3" MinHeight="0" MaxHeight="3" Margin="6,0,0,0"
                                         IsIndeterminate="True" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{Binding OutcomeColor}"
                                     IsVisible="{Binding IsFinished}" VerticalAlignment="Center" Margin="6,0,0,0" />
                          </Grid>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,0" Width="50">
                            <StackPanel Classes="shortcutActions" Orientation="Horizontal" Spacing="2">
                              <Button Command="{Binding OpenCommand}" ToolTip.Tip="{Binding OpenText}" Padding="3"
                                      Width="24" MinWidth="0" Height="24" MinHeight="0">
                                <Image Source="{Binding OpenIcon}" Width="16" Height="16" />
                              </Button>
                              <Button Command="{Binding RunCommand}" ToolTip.Tip="{Binding RunText}" IsVisible="{Binding CanExecute}"
                                      Padding="3" Width="24" MinWidth="0" Height="24" MinHeight="0">
                                <PathIcon Data="M 3,1 L 13,8 L 3,15 Z" Width="14" Height="14" Foreground="#75B96A" />
                              </Button>
                              <Button Command="{Binding RemoveCommand}" ToolTip.Tip="{Binding RemoveText}" IsVisible="{Binding CanRemove}"
                                      Padding="3" Width="24" MinWidth="0" Height="24" MinHeight="0">
                                <PathIcon Data="M 2,3 L 12,3 M 5,1 L 9,1 M 3,5 L 4,14 L 10,14 L 11,5 Z" Width="14" Height="14" Foreground="#E48372" />
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <dock:DockControl x:Name="Workspace" IsVisible="False" InitializeLayout="False" InitializeFactory="False" />
      <Border x:Name="LoadingOverlay" IsVisible="False" Background="#343434">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="300">
          <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Height="4" Foreground="#66D9EF" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</interop:DesktopWindow>
